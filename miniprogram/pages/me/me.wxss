page {
  height: 100%;
  overflow: hidden;
}

.me-page {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #03040d;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background:
    radial-gradient(circle at 9% 8%, rgba(50, 28, 128, 0.46), rgba(50, 28, 128, 0) 35%),
    radial-gradient(circle at 84% 18%, rgba(23, 142, 172, 0.16), rgba(23, 142, 172, 0) 28%),
    radial-gradient(circle at 54% 86%, rgba(89, 31, 177, 0.13), rgba(89, 31, 177, 0) 30%),
    linear-gradient(180deg, #08051a 0%, #050711 42%, #03040d 100%);
}

.bg-pattern {
  opacity: 0.08;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(117, 73, 255, 0.7) 0, rgba(117, 73, 255, 0.22) 10%, transparent 28%),
    radial-gradient(circle at 0 0, rgba(28, 196, 255, 0.5) 0, rgba(28, 196, 255, 0.14) 12%, transparent 30%);
  background-size: 210rpx 210rpx;
}

.bg-glow--top {
  top: -80rpx;
  left: -110rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(62, 50, 184, 0.22) 0%, rgba(62, 50, 184, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -220rpx auto;
  width: 640rpx;
  height: 640rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(222, 68, 255, 0.2) 0%, rgba(222, 68, 255, 0) 72%);
}

.bg-beam {
  position: absolute;
  z-index: 1;
  height: 6rpx;
  border-radius: 999rpx;
  pointer-events: none;
}

.bg-beam--cyan {
  left: 96rpx;
  top: 190rpx;
  width: 310rpx;
  background: linear-gradient(90deg, rgba(63, 220, 255, 0), rgba(63, 220, 255, 0.96));
  box-shadow: 0 0 34rpx rgba(63, 220, 255, 0.7);
  transform: rotate(-42deg);
}

.bg-beam--pink {
  left: 148rpx;
  top: 242rpx;
  width: 300rpx;
  background: linear-gradient(90deg, rgba(255, 70, 221, 0.95), rgba(255, 70, 221, 0));
  box-shadow: 0 0 34rpx rgba(255, 70, 221, 0.72);
  transform: rotate(-38deg);
}

.float-die {
  position: absolute;
  z-index: 1;
  pointer-events: none;
  filter: drop-shadow(0 10rpx 24rpx rgba(30, 192, 255, 0.3));
}

.float-die--a {
  left: 52rpx;
  top: 252rpx;
  width: 58rpx;
  height: 58rpx;
  opacity: 0.7;
  filter: drop-shadow(0 0 18rpx rgba(142, 54, 255, 0.78));
}

.float-die--b {
  right: 246rpx;
  top: 172rpx;
  width: 18rpx;
  height: 18rpx;
  opacity: 1;
}

.me-shell,
.me-header,
.me-body-scroll,
.me-body-scroll__content,
.profile-card,
.content-stack {
  position: relative;
  z-index: 2;
}

.me-shell {
  height: 100%;
  padding: calc(72rpx + env(safe-area-inset-top)) 24rpx calc(118rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.profile-card {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 206rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 82% 20%, rgba(110, 44, 201, 0.42), rgba(110, 44, 201, 0) 42%),
    radial-gradient(circle at 4% 8%, rgba(255, 70, 221, 0.18), rgba(255, 70, 221, 0) 40%),
    linear-gradient(135deg, rgba(36, 22, 62, 0.92) 0%, rgba(22, 15, 49, 0.96) 52%, rgba(8, 17, 42, 0.95) 100%);
  border: 3rpx solid rgba(174, 66, 255, 0.7);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.08),
    inset 0 0 72rpx rgba(103, 50, 180, 0.2),
    0 14rpx 34rpx rgba(2, 3, 17, 0.42),
    0 0 24rpx rgba(158, 53, 255, 0.28);
}

.profile-card__shine {
  position: absolute;
  right: -34rpx;
  top: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(100, 215, 255, 0.24), rgba(100, 215, 255, 0));
  pointer-events: none;
}

.avatar-shell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 36% 28%, rgba(255, 98, 181, 0.32), rgba(255, 98, 181, 0) 38%),
    linear-gradient(180deg, #332a49, #181427);
  border: 3rpx solid rgba(255, 80, 151, 0.9);
  box-shadow:
    0 0 16rpx rgba(255, 67, 157, 0.42),
    inset 0 0 16rpx rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: #cf4fff;
  border: 4rpx solid #181427;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-badge.is-on {
  background: #cf4fff;
}

.avatar-badge.is-off {
  background: rgba(168, 230, 207, 0.24);
  color: rgba(255, 255, 255, 0.82);
}

.profile-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.profile-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(100, 215, 255, 0.86);
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.profile-title {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1.14;
  font-weight: 900;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.42);
}

.profile-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(232, 226, 255, 0.62);
  font-size: 20rpx;
  line-height: 1.5;
}

.me-header {
  flex-shrink: 0;
}

.section--basic {
  margin-top: 28rpx;
}

.me-body-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 14rpx;
}

.me-body-scroll__content {
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 12rpx;
  padding-left: 2rpx;
  color: rgba(100, 215, 255, 0.86);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-block {
  overflow: hidden;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(119, 80, 255, 0.14), rgba(119, 80, 255, 0) 38%),
    rgba(31, 24, 48, 0.74);
  border: 1rpx solid rgba(119, 80, 170, 0.34);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 18rpx 46rpx rgba(0, 0, 0, 0.26);
}

.row {
  min-height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row:last-child {
  border-bottom: none;
}

.row--editor {
  gap: 14rpx;
}

.row-label {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.row-placeholder {
  color: rgba(255, 255, 255, 0.26);
}

.row-action,
.row-arrow,
.row-value {
  color: rgba(255, 255, 255, 0.42);
  font-size: 24rpx;
  font-weight: 600;
}

.row-action {
  color: #ff6dd2;
}

.row-action.is-disabled {
  opacity: 0.56;
}

.row-arrow {
  font-size: 30rpx;
}

.row-value--accent {
  color: #ff6dd2;
}

.row-value--danger {
  color: #ff6b6b;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2rpx;
  background: rgba(255, 255, 255, 0.04);
}

.stats-item {
  min-width: 0;
  padding: 26rpx 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.stats-value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.stats-label {
  color: rgba(232, 226, 255, 0.62);
  font-size: 20rpx;
  text-align: center;
}

.section-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 4rpx;
  color: rgba(232, 226, 255, 0.5);
  font-size: 19rpx;
  line-height: 1.5;
}

.logout-wrap {
  margin-top: 20rpx;
}

.logout-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 34rpx;
  background: rgba(220, 50, 50, 0.12);
  border: 1rpx solid rgba(220, 50, 50, 0.22);
  color: #ff6b6b;
  font-size: 30rpx;
  font-weight: 800;
}

.logout-btn:active,
.row:active {
  opacity: 0.92;
}

.me-page.is-perf-lite .bg-glow {
  display: none;
}

.me-page.is-perf-lite .bg-beam,
.me-page.is-perf-lite .float-die,
.me-page.is-perf-lite .profile-card__shine {
  display: none;
}

.me-page.is-perf-lite .avatar,
.me-page.is-perf-lite .card-block,
.me-page.is-perf-lite .logout-btn,
.me-page.is-perf-lite .profile-card,
.me-page.is-perf-lite .row {
  animation: none !important;
  transition: none !important;
}

.me-page.is-perf-lite .avatar,
.me-page.is-perf-lite .card-block,
.me-page.is-perf-lite .logout-btn {
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
}

.login-gate {
  position: fixed;
  inset: 0;
  z-index: 10020;
}

.login-gate__mask {
  position: absolute;
  inset: 0;
  background: rgba(8, 9, 16, 0.52);
}

.login-gate__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  min-height: 420rpx;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 0%, rgba(244, 203, 95, 0.11) 0%, rgba(244, 203, 95, 0) 26%),
    radial-gradient(circle at 0% 100%, rgba(34, 185, 111, 0.1) 0%, rgba(34, 185, 111, 0) 34%),
    linear-gradient(180deg, rgba(22, 20, 36, 0.985), rgba(13, 15, 26, 0.97));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 24rpx 62rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__handle {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  margin: 0 auto 24rpx;
}

.login-gate__header {
  position: relative;
  z-index: 1;
  text-align: center;
}

.login-gate__title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__button-stack {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.login-gate__btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 94rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 248, 216, 0.54) 0%, rgba(255, 248, 216, 0) 34%),
    linear-gradient(180deg, #f8e2a6 0%, #f0cc72 48%, #dca93d 100%);
  box-shadow:
    0 16rpx 34rpx rgba(214, 164, 57, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.login-gate__btn.is-disabled {
  background: linear-gradient(180deg, rgba(152, 162, 189, 0.4) 0%, rgba(112, 123, 147, 0.3) 100%);
  box-shadow: none;
}

.login-gate__btn--secondary {
  background: linear-gradient(180deg, rgba(58, 63, 82, 0.92) 0%, rgba(34, 37, 50, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 14rpx 28rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__btn::after {
  border: 0;
}

.login-gate__btn-text {
  color: #2e2106;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__btn-text--secondary {
  color: rgba(244, 247, 251, 0.88);
}

.login-gate__agreement-row {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 0;
}

.login-gate__agreement-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  max-width: 100%;
}

.login-gate__checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(214, 224, 243, 0.22);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.login-gate__checkbox.is-checked {
  border-color: rgba(244, 205, 106, 0.72);
  background: linear-gradient(180deg, #f7db76 0%, #e9c349 100%);
  box-shadow: 0 8rpx 18rpx rgba(233, 195, 73, 0.2);
}

.login-gate__checkbox-mark {
  color: transparent;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.login-gate__checkbox.is-checked .login-gate__checkbox-mark {
  color: #3b250c;
}

.login-gate__agreement-copy {
  flex: 0 1 auto;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  display: flex;
  text-align: center;
}

.login-gate__agreement-copy-text {
  color: rgba(232, 240, 235, 0.68);
  font-size: 22rpx;
  line-height: 1.5;
}

.login-gate__link {
  color: #f6d36f;
  font-size: 22rpx;
  line-height: 1.5;
}

