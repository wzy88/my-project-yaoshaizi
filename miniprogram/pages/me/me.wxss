page {
  height: 100%;
  overflow: hidden;
}

.me-page {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #1c1326;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background: radial-gradient(ellipse at 50% 50%, #27153a 0%, #150821 100%);
}

.bg-pattern {
  opacity: 0.18;
  background-image:
    radial-gradient(circle at 46rpx 46rpx, rgba(66, 32, 94, 0.88) 0, rgba(66, 32, 94, 0.88) 4rpx, transparent 5rpx),
    radial-gradient(circle at 0 0, rgba(66, 32, 94, 0.78) 0, rgba(66, 32, 94, 0.78) 4rpx, transparent 5rpx);
  background-size: 92rpx 92rpx;
}

.bg-glow--top {
  top: -80rpx;
  left: -110rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(120, 40, 160, 0.18) 0%, rgba(120, 40, 160, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -220rpx auto;
  width: 640rpx;
  height: 640rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(35, 181, 111, 0.1) 0%, rgba(35, 181, 111, 0) 70%);
}

.me-shell,
.me-header,
.me-body-scroll,
.me-body-scroll__content,
.profile-card,
.content-stack {
  position: relative;
  z-index: 2;
}

.me-shell {
  height: 100%;
  padding: calc(72rpx + env(safe-area-inset-top)) 20rpx calc(118rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.profile-card {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-shell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(35, 181, 111, 0.4);
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 0 0 22rpx rgba(35, 181, 111, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: #23b56f;
  border: 4rpx solid #1c1326;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-badge.is-on {
  background: #23b56f;
}

.avatar-badge.is-off {
  background: rgba(168, 230, 207, 0.24);
  color: rgba(255, 255, 255, 0.82);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-title {
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(168, 230, 207, 0.82);
  font-size: 20rpx;
  line-height: 1.5;
}

.me-header {
  flex-shrink: 0;
}

.section--basic {
  margin-top: 28rpx;
}

.me-body-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 14rpx;
}

.me-body-scroll__content {
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 12rpx;
  padding-left: 2rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-block {
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16);
}

.row {
  min-height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row:last-child {
  border-bottom: none;
}

.row--editor {
  gap: 14rpx;
}

.row-label {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.row-placeholder {
  color: rgba(255, 255, 255, 0.26);
}

.row-action,
.row-arrow,
.row-value {
  color: rgba(255, 255, 255, 0.42);
  font-size: 24rpx;
  font-weight: 600;
}

.row-action {
  color: #23b56f;
}

.row-action.is-disabled {
  opacity: 0.56;
}

.row-arrow {
  font-size: 30rpx;
}

.row-value--accent {
  color: #23b56f;
}

.row-value--danger {
  color: #ff6b6b;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2rpx;
  background: rgba(255, 255, 255, 0.04);
}

.stats-item {
  min-width: 0;
  padding: 26rpx 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.stats-value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.stats-label {
  color: rgba(168, 230, 207, 0.78);
  font-size: 20rpx;
  text-align: center;
}

.section-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 4rpx;
  color: rgba(168, 230, 207, 0.72);
  font-size: 19rpx;
  line-height: 1.5;
}

.logout-wrap {
  margin-top: 20rpx;
}

.logout-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 30rpx;
  background: rgba(220, 50, 50, 0.12);
  border: 1rpx solid rgba(220, 50, 50, 0.22);
  color: #ff6b6b;
  font-size: 30rpx;
  font-weight: 800;
}

.logout-btn:active,
.row:active {
  opacity: 0.92;
}

.me-page.is-perf-lite .bg-glow {
  display: none;
}

.me-page.is-perf-lite .avatar,
.me-page.is-perf-lite .card-block,
.me-page.is-perf-lite .logout-btn,
.me-page.is-perf-lite .profile-card,
.me-page.is-perf-lite .row {
  animation: none !important;
  transition: none !important;
}

.me-page.is-perf-lite .avatar,
.me-page.is-perf-lite .card-block,
.me-page.is-perf-lite .logout-btn {
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
}

.login-gate {
  position: fixed;
  inset: 0;
  z-index: 10020;
}

.login-gate__mask {
  position: absolute;
  inset: 0;
  background: rgba(8, 9, 16, 0.52);
}

.login-gate__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  min-height: 420rpx;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 0%, rgba(244, 203, 95, 0.11) 0%, rgba(244, 203, 95, 0) 26%),
    radial-gradient(circle at 0% 100%, rgba(34, 185, 111, 0.1) 0%, rgba(34, 185, 111, 0) 34%),
    linear-gradient(180deg, rgba(22, 20, 36, 0.985), rgba(13, 15, 26, 0.97));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 24rpx 62rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__handle {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  margin: 0 auto 24rpx;
}

.login-gate__header {
  position: relative;
  z-index: 1;
  text-align: center;
}

.login-gate__title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__button-stack {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.login-gate__btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 94rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 248, 216, 0.54) 0%, rgba(255, 248, 216, 0) 34%),
    linear-gradient(180deg, #f8e2a6 0%, #f0cc72 48%, #dca93d 100%);
  box-shadow:
    0 16rpx 34rpx rgba(214, 164, 57, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.login-gate__btn.is-disabled {
  background: linear-gradient(180deg, rgba(152, 162, 189, 0.4) 0%, rgba(112, 123, 147, 0.3) 100%);
  box-shadow: none;
}

.login-gate__btn--secondary {
  background: linear-gradient(180deg, rgba(58, 63, 82, 0.92) 0%, rgba(34, 37, 50, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 14rpx 28rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__btn::after {
  border: 0;
}

.login-gate__btn-text {
  color: #2e2106;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__btn-text--secondary {
  color: rgba(244, 247, 251, 0.88);
}

.login-gate__agreement-row {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 0;
}

.login-gate__agreement-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  max-width: 100%;
}

.login-gate__checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(214, 224, 243, 0.22);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.login-gate__checkbox.is-checked {
  border-color: rgba(244, 205, 106, 0.72);
  background: linear-gradient(180deg, #f7db76 0%, #e9c349 100%);
  box-shadow: 0 8rpx 18rpx rgba(233, 195, 73, 0.2);
}

.login-gate__checkbox-mark {
  color: transparent;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.login-gate__checkbox.is-checked .login-gate__checkbox-mark {
  color: #3b250c;
}

.login-gate__agreement-copy {
  flex: 0 1 auto;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  display: flex;
  text-align: center;
}

.login-gate__agreement-copy-text {
  color: rgba(232, 240, 235, 0.68);
  font-size: 22rpx;
  line-height: 1.5;
}

.login-gate__link {
  color: #f6d36f;
  font-size: 22rpx;
  line-height: 1.5;
}
