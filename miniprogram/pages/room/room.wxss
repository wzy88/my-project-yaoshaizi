    linear-gradient(180deg, rgba(12, 10, 25, 0.92) 0%, rgba(17, 14, 30, 0.84) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(214, 222, 244, 0.78);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.seat-direction__item.is-active {
