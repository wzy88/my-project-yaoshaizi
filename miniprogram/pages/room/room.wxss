.room-theme-loader {
  position: absolute;
  inset: 0;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 72rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 34%, rgba(247, 207, 118, 0.18) 0, rgba(247, 207, 118, 0) 30%),
    linear-gradient(180deg, #171018 0%, #0d0b10 100%);
}

.room-theme-loader__die {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  animation: room-theme-loader-spin 1.28s ease-in-out infinite;
  transform-style: preserve-3d;
}

.room-theme-loader__die-face {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7dc 0%, #d6b669 100%);
  border: 2rpx solid rgba(255, 239, 180, 0.86);
  box-shadow: 0 22rpx 46rpx rgba(0, 0, 0, 0.35), 0 0 34rpx rgba(238, 194, 93, 0.28);
}

.room-theme-loader__die-face--back {
  transform: translateZ(-24rpx) rotateY(180deg);
  opacity: 0.56;
}

.room-theme-loader__pip {
  width: 16rpx;
  height: 16rpx;
  align-self: center;
  justify-self: center;
  border-radius: 50%;
  background: #3a211d;
}

.room-theme-loader__pip:nth-child(1) {
  grid-column: 1;
  grid-row: 1;
}

.room-theme-loader__pip:nth-child(2) {
  grid-column: 2;
  grid-row: 2;
}

.room-theme-loader__pip:nth-child(3) {
  grid-column: 3;
  grid-row: 3;
}

.room-theme-loader__copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.room-theme-loader__title {
  max-width: 520rpx;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #fff4d7;
}

.room-theme-loader__step {
  max-width: 520rpx;
  font-size: 23rpx;
  line-height: 1.3;
  color: rgba(245, 238, 216, 0.78);
}

.room-theme-loader__bar {
  width: 360rpx;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.room-theme-loader__bar-fill {
  height: 100%;
  min-width: 36rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #7ed6f7 0%, #f7cf76 56%, #f08d70 100%);
  transition: width 180ms ease;
}

@keyframes room-theme-loader-spin {
  0% {
    transform: rotate(-8deg) rotateY(0deg) scale(0.94);
  }
  50% {
    transform: rotate(8deg) rotateY(180deg) scale(1.04);
  }
  100% {
    transform: rotate(-8deg) rotateY(360deg) scale(0.94);
  }
}

