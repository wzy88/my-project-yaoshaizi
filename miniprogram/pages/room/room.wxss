.room-self__dice-cup.is-rolling {
  transform-origin: 50% 72%;
  animation: room-self-cup-rock 220ms cubic-bezier(0.36, 0.02, 0.22, 1) infinite;
}

.room-self__dice-cup.is-rolling .room-self__dice-stack {
  animation: room-self-stack-shift 170ms cubic-bezier(0.39, 0, 0.24, 1) infinite;
}

.room-self__dice-cup.is-rolling .room-self__die.is-pending {
  animation-name: room-self-die-spin;
  animation-timing-function: cubic-bezier(0.38, 0, 0.24, 1);
  animation-iteration-count: infinite;
}

.room-self__dice-cup.is-revealing {
  transform-origin: 50% 76%;
  animation: room-self-cup-settle 340ms ease-out 1;
}

.room-self__dice-cup.is-revealing .room-self__dice-stack {
  animation: none;
}

.room-self__dice-cup.is-revealing .room-self__die.is-pending {
  animation-name: room-self-die-spin-reveal;
  animation-timing-function: cubic-bezier(0.36, 0, 0.22, 1);
  animation-iteration-count: infinite;
}

.room-self__dice-cup.is-revealing .room-self__die.is-revealed,
.room-self__dice-cup.is-revealed .room-self__die {
  animation: room-self-die-settle 260ms ease-out;
}

.room-self__dice-cup.is-revealing .room-self__die-slot.is-revealed {
  opacity: 1;
}

.room-self__dice-cup.is-revealing .room-self__die-slot.is-pending {
  opacity: 0.96;
}

.room-self__dice-cup.is-revealed .room-self__die {
  animation: room-self-die-settle 260ms ease-out;
}

@keyframes call-phase-panel-rise {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scaleY(0.988);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes room-self-cup-rock {
  0% {
    transform: translate(-10rpx, -14rpx) rotate(-10deg);
  }

  25% {
    transform: translate(16rpx, -22rpx) rotate(-16deg);
  }

  50% {
    transform: translate(20rpx, 4rpx) rotate(16deg);
  }

  75% {
    transform: translate(-18rpx, 16rpx) rotate(18deg);
  }

  100% {
    transform: translate(10rpx, 20rpx) rotate(-8deg);
  }
}

@keyframes room-self-cup-settle {
  0% {
    transform: translate(12rpx, 16rpx) rotate(-7deg);
  }

  55% {
    transform: translate(-4rpx, -2rpx) rotate(2deg);
  }

  100% {
    transform: translate(0, 0) rotate(0deg);
  }
}

@keyframes room-self-stack-shift {
  0% {
    transform: translate(-12rpx, -16rpx) scale(0.92);
  }

  35% {
    transform: translate(18rpx, -6rpx) scale(1.05);
  }

  70% {
    transform: translate(-16rpx, 14rpx) scale(0.97);
  }

  100% {
    transform: translate(14rpx, 22rpx) scale(1.03);
  }
}

@keyframes room-self-die-spin {
  0% {
    transform: translate(-12rpx, -18rpx) rotate(-26deg) scale(0.86);
  }

  25% {
    transform: translate(18rpx, -10rpx) rotate(118deg) scale(1.08);
  }

  50% {
    transform: translate(-16rpx, 14rpx) rotate(226deg) scale(0.9);
  }

  75% {
    transform: translate(20rpx, 12rpx) rotate(332deg) scale(1.08);
  }

  100% {
    transform: translate(-10rpx, 22rpx) rotate(418deg) scale(0.94);
  }
}

@keyframes room-self-die-spin-reveal {
  0% {
    transform: translate(-8rpx, -12rpx) rotate(-22deg) scale(0.9);
  }

  30% {
    transform: translate(14rpx, -6rpx) rotate(94deg) scale(1.02);
  }

  68% {
    transform: translate(-12rpx, 10rpx) rotate(188deg) scale(0.94);
  }

  100% {
    transform: translate(10rpx, 12rpx) rotate(282deg) scale(0.98);
  }
}

@keyframes room-self-die-settle {
  0% {
    opacity: 0.4;
    transform: translateY(16rpx) scale(0.88);
    filter: drop-shadow(0 0 0 rgba(233, 195, 73, 0));
  }

  60% {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.03);
    filter: drop-shadow(0 10rpx 24rpx rgba(0, 0, 0, 0.48));
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: drop-shadow(0 8rpx 26rpx rgba(0, 0, 0, 0.55));
  }
}

