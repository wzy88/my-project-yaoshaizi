    inset 0 1rpx 0 rgba(255, 255, 255, 0.07),
    0 10rpx 22rpx rgba(0, 0, 0, 0.28);
}

.call-phase-panel__count.is-disabled,
.call-phase-panel__point-option.is-disabled,
.call-phase-panel__point-box.is-disabled {
  opacity: 1;
  filter: none;
  background:
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 2rpx, rgba(255, 255, 255, 0) 2rpx 10rpx),
    linear-gradient(180deg, rgba(40, 45, 54, 0.62) 0%, rgba(18, 22, 30, 0.78) 100%);
