page {
  height: 100%;
  overflow: hidden;
}

.page {
  position: relative;
  height: 100%;
  min-height: 100%;
  padding: calc(20rpx + env(safe-area-inset-top)) 18rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #22063f 0%, #17052f 34%, #120329 68%, #0d021d 100%);
  color: #f7f4ee;
}

.room-shell {
  position: relative;
  z-index: 1;
  min-height: 1624rpx;
}

.seat {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.seat.is-turn {
  z-index: 4;
}

.seat__glow {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  left: -14rpx;
  border-radius: 50%;
  opacity: 0.8;
}

.seat__glow.glow-gold {
  box-shadow: 0 0 0 3rpx rgba(240, 195, 58, 0.88), 0 0 18rpx rgba(240, 195, 58, 0.52);
}

.seat__glow.glow-violet {
  box-shadow: 0 0 0 3rpx rgba(156, 62, 255, 0.88), 0 0 18rpx rgba(156, 62, 255, 0.52);
}

.seat__glow.glow-amber {
  box-shadow: 0 0 0 3rpx rgba(246, 176, 55, 0.88), 0 0 18rpx rgba(246, 176, 55, 0.52);
}

.seat__glow.glow-self {
  box-shadow: 0 0 0 3rpx rgba(49, 237, 227, 0.92), 0 0 22rpx rgba(49, 237, 227, 0.62);
}

.seat__badge {
  position: absolute;
  left: 50%;
  top: 102rpx;
  min-width: 72rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  line-height: 1.2;
  text-align: center;
  color: #ffe29a;
  background: rgba(16, 10, 20, 0.88);
  border: 1rpx solid rgba(233, 195, 73, 0.32);
  transform: translateX(-50%);
}

.seat__badge.badge-owner {
  color: #ffd55e;
}

.seat__badge.badge-seat {
  color: #f0c96a;
}

.seat__avatar-shell {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(18, 9, 28, 0.9);
}

.seat.is-self .seat__avatar-shell {
  width: 128rpx;
  height: 128rpx;
}

.seat__avatar {
  width: 100%;
  height: 100%;
}

.seat__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #f1d59c;
}

.seat__name-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 12rpx;
  max-width: 180rpx;
}

.seat__name {
  font-size: 22rpx;
  color: #f7f3e8;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ghost-cup {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 76rpx;
  height: 130rpx;
  z-index: 2;
}

.ghost-avatar {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 2;
}

.ghost-avatar__glow {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  left: -14rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(240, 195, 58, 0.72), 0 0 18rpx rgba(240, 195, 58, 0.38);
}

.ghost-avatar__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.28);
}

.seat__bubble {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 5;
  min-width: 170rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(10, 6, 26, 0.88);
  border: 1rpx solid rgba(218, 178, 28, 0.32);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.55);
}

.seat__bubble.latest {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.55), 0 0 16rpx rgba(233, 195, 73, 0.28);
}

.seat__bubble-count {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  color: #e9c349;
  text-shadow: 0 0 12rpx rgba(233, 195, 73, 0.44);
}

.seat__bubble-unit {
  font-size: 22rpx;
  color: rgba(178, 188, 212, 0.72);
}

.seat__bubble-die {
  width: 38rpx;
  height: 38rpx;
}

.my-dice-tray {
  position: absolute;
  left: 382rpx;
  top: 1158rpx;
  z-index: 4;
}

.my-dice-tray__inner {
  width: 136rpx;
  min-height: 148rpx;
  padding: 10rpx 10rpx 8rpx;
  border-radius: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.12)), rgba(84, 118, 108, 0.82);
  box-shadow: 0 12rpx 20rpx rgba(0, 0, 0, 0.24);
}

.my-dice-tray__die {
  width: 40rpx;
  height: 40rpx;
}

.my-dice-tray__base {
  width: 112rpx;
  height: 18rpx;
  margin: 0 auto;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #dce3e8 0%, #b2bcc4 52%, #8a9197 100%);
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.32);
}

.control-bar {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
}

.control-panel {
  position: relative;
  padding: 30rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(75, 95, 200, 0.18);
  background: linear-gradient(0deg, rgba(15, 20, 75, 0.98) 0%, rgba(20, 27, 90, 0.95) 48%, rgba(12, 16, 62, 0.84) 78%, rgba(12, 16, 62, 0) 100%);
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
}

.control-panel__hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 21rpx;
  color: rgba(198, 206, 232, 0.78);
  text-align: center;
}

.control-panel__cta-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-panel__cta-row.has-secondary {
  gap: 12rpx;
}

.control-panel__actions {
  display: block;
}

.control-panel--generic .control-panel__hint {
  margin-bottom: 18rpx;
}

.control-panel--generic .control-cta-btn {
  width: 100%;
  height: 124rpx;
}

.control-cta-btn,
.call-submit-btn,
.dock-btn--gold,
.dock-btn--settlement {
  flex: 1;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f3dc58 0%, #e9c349 38%, #c39625 70%, #9f7317 100%);
  border: 1rpx solid #ffe088;
  box-shadow: 0 10rpx 28rpx rgba(233, 195, 73, 0.34);
}

.control-cta-btn--disabled {
  opacity: 0.52;
}

.control-cta-btn__label,
.call-submit-btn__label,
.dock-btn__label {
  font-size: 40rpx;
  font-weight: 900;
  color: #1a0c00;
  letter-spacing: 4rpx;
}

.call-submit-btn {
  flex: 0 0 188rpx;
  height: 92rpx;
}

.call-submit-btn__label {
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

.control-mini-btn,
.dock-btn--ghost {
  min-width: 124rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(26, 32, 48, 0.96), rgba(14, 18, 28, 0.96));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  color: rgba(205, 214, 238, 0.78);
  font-size: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.44);
}

.dock-btn--ghost .dock-btn__label {
  color: rgba(205, 214, 238, 0.82);
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.control-mini-btn--ghost {
  flex: 0 0 124rpx;
}

.count-strip,
.point-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-strip {
  margin-bottom: 14rpx;
}

.point-strip {
  margin-top: 14rpx;
}

.count-tile {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(39, 44, 68, 0.96), rgba(18, 22, 38, 0.96));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 -14rpx 18rpx rgba(73, 76, 150, 0.24), 0 8rpx 14rpx rgba(0, 0, 0, 0.32);
}

.count-tile.is-active {
  border-color: #e9c349;
  background: linear-gradient(180deg, rgba(53, 47, 88, 0.96), rgba(28, 26, 68, 0.96));
  box-shadow: 0 0 22rpx rgba(233, 195, 73, 0.24);
}

.count-tile__label {
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(190, 198, 224, 0.82);
}

.count-tile.is-active .count-tile__label {
  color: #f0d25a;
}

.call-editor {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.call-editor__card {
  height: 92rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 240, 218, 0.96);
  border: 2rpx solid rgba(208, 192, 155, 0.62);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.24);
}

.call-editor__card--count {
  width: 98rpx;
}

.call-editor__card--point {
  width: 98rpx;
  position: relative;
}

.call-editor__count {
  font-size: 62rpx;
  line-height: 1;
  font-weight: 900;
  color: #17100a;
}

.call-editor__unit {
  font-size: 32rpx;
  color: rgba(188, 198, 225, 0.78);
}

.call-editor__die {
  width: 54rpx;
  height: 54rpx;
}

.call-editor__arrow {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  color: #999;
}

.point-tile {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 27, 44, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.point-tile.is-active {
  border-color: #e9c349;
  box-shadow: 0 0 18rpx rgba(233, 195, 73, 0.22);
}

.point-tile__die {
  width: 44rpx;
  height: 44rpx;
}

.control-panel__foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.control-panel__foot-copy {
  flex: 1;
  font-size: 20rpx;
  color: rgba(187, 196, 225, 0.64);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.control-panel__foot-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.control-panel__foot-link {
  font-size: 22rpx;
  color: #f0cb53;
}

.control-voice-btn {
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 32, 78, 0.9);
  border: 1rpx solid rgba(120, 147, 246, 0.28);
  color: rgba(222, 230, 249, 0.84);
  font-size: 20rpx;
}

.room-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  padding: 48rpx 24rpx;
  background: rgba(8, 6, 18, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.room-mask--drawer {
  padding: 0 20rpx calc(20rpx + env(safe-area-inset-bottom));
  align-items: flex-end;
  justify-content: flex-end;
  background:
    linear-gradient(180deg, rgba(7, 6, 14, 0.26) 0%, rgba(7, 6, 14, 0.78) 100%);
  backdrop-filter: blur(14rpx);
}

.room-mask--settings {
  background:
    radial-gradient(circle at 18% 16%, rgba(247, 201, 95, 0.15) 0%, rgba(247, 201, 95, 0) 34%),
    radial-gradient(circle at 82% 12%, rgba(46, 188, 117, 0.12) 0%, rgba(46, 188, 117, 0) 32%),
    rgba(6, 6, 14, 0.76);
  backdrop-filter: blur(16rpx);
}

.room-mask--seating {
  padding-top: calc(env(safe-area-inset-top) + 118rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  align-items: flex-start;
}

.room-sheet {
  width: 100%;
  position: relative;
  max-height: 100%;
  border-radius: 30rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(32, 18, 54, 0.98), rgba(18, 12, 34, 0.98));
  border: 1rpx solid rgba(255, 224, 136, 0.18);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.room-sheet__glow {
  position: absolute;
  pointer-events: none;
  border-radius: 999rpx;
  filter: blur(10rpx);
  opacity: 0.9;
}

.room-sheet__glow--settlement-a,
.room-sheet__glow--settings-a,
.room-sheet__glow--legal-a {
  width: 220rpx;
  height: 220rpx;
  top: -84rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(244, 203, 95, 0.34) 0%, rgba(244, 203, 95, 0) 72%);
}

.room-sheet__glow--settlement-b,
.room-sheet__glow--settings-b,
.room-sheet__glow--legal-b {
  width: 240rpx;
  height: 240rpx;
  left: -68rpx;
  bottom: -92rpx;
  background: radial-gradient(circle, rgba(41, 186, 119, 0.2) 0%, rgba(41, 186, 119, 0) 74%);
}

.room-sheet--settlement {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(243, 205, 105, 0.16) 0%, rgba(243, 205, 105, 0.03) 36%, rgba(243, 205, 105, 0) 56%),
    radial-gradient(circle at 100% 100%, rgba(35, 181, 111, 0.14) 0%, rgba(35, 181, 111, 0) 58%),
    linear-gradient(180deg, rgba(47, 34, 67, 0.98) 0%, rgba(26, 20, 38, 0.98) 100%);
  border-color: rgba(247, 213, 130, 0.16);
  box-shadow:
    0 28rpx 76rpx rgba(0, 0, 0, 0.56),
    inset 0 1rpx 0 rgba(255, 248, 220, 0.12),
    inset 0 -28rpx 46rpx rgba(0, 0, 0, 0.18),
    0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.room-sheet--settings {
  max-width: 682rpx;
  background:
    radial-gradient(circle at 8% 0%, rgba(245, 219, 126, 0.16) 0%, rgba(245, 219, 126, 0.03) 42%, rgba(245, 219, 126, 0) 58%),
    radial-gradient(circle at 100% 100%, rgba(42, 190, 112, 0.14) 0%, rgba(42, 190, 112, 0) 58%),
    linear-gradient(180deg, rgba(34, 29, 55, 0.98) 0%, rgba(17, 14, 29, 0.99) 100%);
  border-color: rgba(245, 221, 140, 0.16);
  box-shadow:
    0 30rpx 82rpx rgba(0, 0, 0, 0.56),
    inset 0 1rpx 0 rgba(255, 248, 220, 0.12),
    inset 0 -24rpx 40rpx rgba(0, 0, 0, 0.18),
    0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.room-sheet--seating {
  max-width: 638rpx;
  max-height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 144rpx);
  background:
    radial-gradient(circle at 8% 0%, rgba(245, 219, 126, 0.14) 0%, rgba(245, 219, 126, 0.03) 40%, rgba(245, 219, 126, 0) 58%),
    radial-gradient(circle at 100% 100%, rgba(42, 190, 112, 0.12) 0%, rgba(42, 190, 112, 0) 58%),
    linear-gradient(180deg, rgba(35, 30, 55, 0.98) 0%, rgba(18, 15, 29, 0.99) 100%);
  border-color: rgba(245, 221, 140, 0.16);
  box-shadow:
    0 30rpx 82rpx rgba(0, 0, 0, 0.56),
    inset 0 1rpx 0 rgba(255, 248, 220, 0.1),
    inset 0 -22rpx 38rpx rgba(0, 0, 0, 0.16),
    0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.room-sheet--seating .sheet-head {
  padding: 18rpx 20rpx 12rpx;
}

.room-sheet--seating .sheet-eyebrow {
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.room-sheet--seating .sheet-title {
  font-size: 28rpx;
}

.room-sheet--seating .sheet-close--pill {
  min-width: 76rpx;
  height: 46rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
}

.room-sheet--legal {
  width: 100%;
  max-width: 710rpx;
  border-radius: 38rpx 38rpx 30rpx 30rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(243, 205, 105, 0.18) 0%, rgba(243, 205, 105, 0.04) 34%, rgba(243, 205, 105, 0) 56%),
    radial-gradient(circle at 100% 100%, rgba(35, 181, 111, 0.14) 0%, rgba(35, 181, 111, 0) 58%),
    linear-gradient(180deg, rgba(35, 28, 54, 0.99) 0%, rgba(18, 14, 29, 0.99) 100%);
  border-color: rgba(247, 213, 130, 0.18);
  box-shadow:
    0 32rpx 80rpx rgba(0, 0, 0, 0.54),
    inset 0 1rpx 0 rgba(255, 248, 220, 0.1),
    0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sheet-head--settlement,
.sheet-head--settings {
  position: relative;
  z-index: 1;
  padding-top: 30rpx;
  padding-bottom: 18rpx;
  border-bottom-color: rgba(255, 244, 205, 0.08);
}

.sheet-head--legal {
  position: relative;
  z-index: 1;
  padding-top: 18rpx;
  padding-bottom: 16rpx;
  border-bottom-color: rgba(255, 244, 205, 0.08);
}

.sheet-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sheet-eyebrow {
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: rgba(240, 201, 102, 0.9);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f7f3e8;
}

.sheet-close--pill {
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 247, 212, 0.1), rgba(255, 255, 255, 0.02));
  border: 1rpx solid rgba(246, 220, 132, 0.14);
  color: #f7efda;
  font-weight: 700;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.entry-sheet__headline {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.entry-sheet__eyebrow {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #f0c870;
}

.entry-sheet__desc {
  font-size: 22rpx;
  color: rgba(214, 222, 244, 0.76);
}

.sheet-close {
  font-size: 24rpx;
  color: rgba(213, 224, 243, 0.74);
}

.sheet-body {
  padding: 24rpx 28rpx 30rpx;
  box-sizing: border-box;
}

.sheet-body--settlement,
.sheet-body--settings {
  position: relative;
  z-index: 1;
}

.sheet-body--seating {
  position: relative;
  z-index: 1;
  max-height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 248rpx);
  padding: 12rpx 18rpx 20rpx;
  box-sizing: border-box;
}

.sheet-body--settlement {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.sheet-body--entry {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sheet-body--legal {
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
}

.sheet-actions,
.join-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.dock-btn {
  flex: 1;
  transition: transform 90ms ease-out, opacity 90ms ease-out, filter 90ms ease-out;
}

.dock-btn--disabled {
  opacity: 0.48;
}

.dock-btn--pressing {
  transform: scale(0.982);
  filter: brightness(0.98);
}

.join-server-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(11, 9, 24, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.join-server-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.join-server-card__action {
  font-size: 24rpx;
  color: #f0c870;
}

.join-server-card__value {
  font-size: 24rpx;
  color: #f7f3e8;
  word-break: break-all;
}

.join-server-card__hint {
  font-size: 22rpx;
