page {
  height: 100%;
  overflow: hidden;
}

.page {
  position: relative;
  height: 100%;
  min-height: 100%;
  padding: calc(20rpx + env(safe-area-inset-top)) 18rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #22063f 0%, #17052f 34%, #120329 68%, #0d021d 100%);
  color: #f7f4ee;
}

.sky-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    radial-gradient(circle at 50% 6%, rgba(145, 42, 255, 0.55) 0, rgba(145, 42, 255, 0.18) 18%, rgba(145, 42, 255, 0) 38%),
    radial-gradient(circle at 6% 48%, rgba(124, 25, 221, 0.44) 0, rgba(124, 25, 221, 0.10) 20%, rgba(124, 25, 221, 0) 38%),
    radial-gradient(circle at 94% 48%, rgba(124, 25, 221, 0.44) 0, rgba(124, 25, 221, 0.10) 20%, rgba(124, 25, 221, 0) 38%),
    linear-gradient(180deg, #22063f 0%, #1a0636 28%, #13042c 62%, #0d021d 100%);
}

.sky-texture {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
  pointer-events: none;
}

.sky-stars {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.sky-star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.8);
}

.sky-star--1 { left: 120rpx; top: 96rpx; width: 4rpx; height: 4rpx; }
.sky-star--2 { left: 214rpx; top: 78rpx; width: 5rpx; height: 5rpx; }
.sky-star--3 { right: 136rpx; top: 110rpx; width: 4rpx; height: 4rpx; }
.sky-star--4 { left: 82rpx; top: 188rpx; width: 5rpx; height: 5rpx; }
.sky-star--5 { right: 74rpx; top: 214rpx; width: 4rpx; height: 4rpx; }
.sky-star--6 { left: 144rpx; top: 310rpx; width: 4rpx; height: 4rpx; opacity: 0.56; }
.sky-star--7 { right: 128rpx; top: 356rpx; width: 4rpx; height: 4rpx; opacity: 0.56; }
.sky-star--8 { left: 98rpx; top: 468rpx; width: 3rpx; height: 3rpx; opacity: 0.52; }
.sky-star--9 { right: 90rpx; top: 512rpx; width: 3rpx; height: 3rpx; opacity: 0.52; }
.sky-star--10 { left: 222rpx; top: 620rpx; width: 4rpx; height: 4rpx; opacity: 0.5; }

.room-shell {
  position: relative;
  z-index: 1;
  min-height: 1624rpx;
}

.figma-top {
  position: absolute;
  top: 48rpx;
  right: 18rpx;
  z-index: 6;
}

.room-pill {
  min-width: 150rpx;
  padding: 10rpx 18rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(8, 4, 20, 0.72);
  border: 1rpx solid rgba(220, 185, 30, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.room-pill--floating {
  position: absolute;
  left: 14rpx;
  top: 56rpx;
  z-index: 4;
}

.room-pill__title {
  font-size: 23rpx;
  font-weight: 700;
  color: #f4f0ec;
}

.room-pill__meta {
  font-size: 18rpx;
  color: rgba(175, 190, 210, 0.62);
}

.top-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 5;
}

.top-status__time {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0ece8;
}

.top-status__battery {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.26);
  border: 1rpx solid rgba(34, 200, 68, 0.35);
}

.top-status__battery-icon {
  width: 36rpx;
  height: 20rpx;
}

.room-hero {
  position: absolute;
  left: 50%;
  top: 146rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.room-hero__name {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8f1dc;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.56);
}

.room-hero__avatar-wrap {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.room-hero__halo {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  left: -20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 212, 44, 0.44) 0, rgba(255, 212, 44, 0.12) 38%, rgba(255, 212, 44, 0) 68%);
}

.room-hero__ring {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  border: 5rpx solid #f0c33a;
  box-shadow: 0 0 18rpx rgba(240, 195, 58, 0.72);
}

.room-hero__avatar {
  width: 102rpx;
  height: 102rpx;
  border-radius: 51rpx;
  background: rgba(23, 7, 42, 0.92);
}

.room-hero__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #f2d79f;
}

.figma-table {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 324rpx;
  height: 1020rpx;
  overflow: visible;
}

.figma-table__frame {
  position: absolute;
  inset: 0;
  border-radius: 64rpx;
  background:
    radial-gradient(circle at 50% 12%, rgba(255, 222, 120, 0.16), rgba(255, 222, 120, 0) 34%),
    linear-gradient(180deg, rgba(16, 16, 26, 0.12), rgba(16, 16, 26, 0.18));
  box-shadow:
    0 0 0 3rpx rgba(200, 155, 28, 0.22),
    0 0 0 8rpx rgba(200, 155, 28, 0.08),
    0 0 34rpx rgba(185, 135, 18, 0.34),
    0 20rpx 56rpx rgba(0, 0, 0, 0.7);
}

.figma-table__felt {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 56rpx;
  background:
    radial-gradient(circle at 50% 48%, rgba(64, 175, 110, 0.18), rgba(64, 175, 110, 0) 42%),
    linear-gradient(180deg, #0a3327 0%, #114936 22%, #1f7355 50%, #205d4b 80%, #17453a 100%);
  overflow: hidden;
}

.figma-table__texture {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 56rpx;
  opacity: 0.26;
}

.figma-table__notch {
  position: absolute;
  top: -4rpx;
  width: 44rpx;
  height: 34rpx;
  background: linear-gradient(180deg, rgba(201, 152, 28, 0.88), rgba(141, 103, 16, 0.9));
  box-shadow: 0 0 12rpx rgba(210, 165, 18, 0.4);
}

.figma-table__notch--left {
  left: 48%;
  clip-path: polygon(0 0, 100% 0, 82% 100%, 18% 100%);
  transform: translateX(-52rpx);
}

.figma-table__notch--right {
  left: 52%;
  clip-path: polygon(0 0, 100% 0, 82% 100%, 18% 100%);
  transform: translateX(10rpx);
}

.table-watermark {
  position: absolute;
  left: 50%;
  top: 476rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.11;
}

.table-watermark__cn {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.table-watermark__en {
  font-size: 22rpx;
  letter-spacing: 8rpx;
}

.seat {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.seat.is-turn {
  z-index: 4;
}

.seat__glow {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  left: -14rpx;
  border-radius: 50%;
  opacity: 0.8;
}

.seat__glow.glow-gold {
  box-shadow: 0 0 0 3rpx rgba(240, 195, 58, 0.88), 0 0 18rpx rgba(240, 195, 58, 0.52);
}

.seat__glow.glow-violet {
  box-shadow: 0 0 0 3rpx rgba(156, 62, 255, 0.88), 0 0 18rpx rgba(156, 62, 255, 0.52);
}

.seat__glow.glow-amber {
  box-shadow: 0 0 0 3rpx rgba(246, 176, 55, 0.88), 0 0 18rpx rgba(246, 176, 55, 0.52);
}

.seat__glow.glow-self {
  box-shadow: 0 0 0 3rpx rgba(49, 237, 227, 0.92), 0 0 22rpx rgba(49, 237, 227, 0.62);
}

.seat__badge {
  position: absolute;
  left: 50%;
  top: 102rpx;
  min-width: 72rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  line-height: 1.2;
  text-align: center;
  color: #ffe29a;
  background: rgba(16, 10, 20, 0.88);
  border: 1rpx solid rgba(233, 195, 73, 0.32);
  transform: translateX(-50%);
}

.seat__badge.badge-owner {
  color: #ffd55e;
}

.seat__badge.badge-seat {
  color: #f0c96a;
}

.seat__avatar-shell {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(18, 9, 28, 0.9);
}

.seat.is-self .seat__avatar-shell {
  width: 128rpx;
  height: 128rpx;
}

.seat__avatar {
  width: 100%;
  height: 100%;
}

.seat__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #f1d59c;
}

.seat__name-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 12rpx;
  max-width: 180rpx;
}

.seat__name {
  font-size: 22rpx;
  color: #f7f3e8;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ghost-cup {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 76rpx;
  height: 130rpx;
  z-index: 2;
}

.ghost-avatar {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 2;
}

.ghost-avatar__glow {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  left: -14rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(240, 195, 58, 0.72), 0 0 18rpx rgba(240, 195, 58, 0.38);
}

.ghost-avatar__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.28);
}

.seat__bubble {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 5;
  min-width: 170rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(10, 6, 26, 0.88);
  border: 1rpx solid rgba(218, 178, 28, 0.32);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.55);
}

.seat__bubble.latest {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.55), 0 0 16rpx rgba(233, 195, 73, 0.28);
}

.seat__bubble-count {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  color: #e9c349;
  text-shadow: 0 0 12rpx rgba(233, 195, 73, 0.44);
}

.seat__bubble-unit {
  font-size: 22rpx;
  color: rgba(178, 188, 212, 0.72);
}

.seat__bubble-die {
  width: 38rpx;
  height: 38rpx;
}

.my-dice-tray {
  position: absolute;
  left: 382rpx;
  top: 1158rpx;
  z-index: 4;
}

.my-dice-tray__inner {
  width: 136rpx;
  min-height: 148rpx;
  padding: 10rpx 10rpx 8rpx;
  border-radius: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.12)), rgba(84, 118, 108, 0.82);
  box-shadow: 0 12rpx 20rpx rgba(0, 0, 0, 0.24);
}

.my-dice-tray__die {
  width: 40rpx;
  height: 40rpx;
}

.my-dice-tray__base {
  width: 112rpx;
  height: 18rpx;
  margin: 0 auto;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #dce3e8 0%, #b2bcc4 52%, #8a9197 100%);
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.32);
}

.control-bar {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
}

.control-panel {
  position: relative;
  padding: 30rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(75, 95, 200, 0.18);
  background: linear-gradient(0deg, rgba(15, 20, 75, 0.98) 0%, rgba(20, 27, 90, 0.95) 48%, rgba(12, 16, 62, 0.84) 78%, rgba(12, 16, 62, 0) 100%);
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
}

.control-panel__hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 21rpx;
  color: rgba(198, 206, 232, 0.78);
  text-align: center;
}

.control-panel__cta-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-panel__cta-row.has-secondary {
  gap: 12rpx;
}

.control-panel__actions {
  display: block;
}

.control-panel--generic .control-panel__hint {
  margin-bottom: 18rpx;
}

.control-panel--generic .control-cta-btn {
  width: 100%;
  height: 124rpx;
}

.control-cta-btn,
.call-submit-btn,
.dock-btn--gold,
.dock-btn--settlement {
  flex: 1;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f3dc58 0%, #e9c349 38%, #c39625 70%, #9f7317 100%);
  border: 1rpx solid #ffe088;
  box-shadow: 0 10rpx 28rpx rgba(233, 195, 73, 0.34);
}

.control-cta-btn--disabled {
  opacity: 0.52;
}

.control-cta-btn__label,
.call-submit-btn__label,
.dock-btn__label {
  font-size: 40rpx;
  font-weight: 900;
  color: #1a0c00;
  letter-spacing: 4rpx;
}

.call-submit-btn {
  flex: 0 0 188rpx;
  height: 92rpx;
}

.call-submit-btn__label {
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

.control-mini-btn,
.dock-btn--ghost {
  min-width: 124rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(26, 32, 48, 0.96), rgba(14, 18, 28, 0.96));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  color: rgba(205, 214, 238, 0.78);
  font-size: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.44);
}

.dock-btn--ghost .dock-btn__label {
  color: rgba(205, 214, 238, 0.82);
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.control-mini-btn--ghost {
  flex: 0 0 124rpx;
}

.count-strip,
.point-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-strip {
  margin-bottom: 14rpx;
}

.point-strip {
  margin-top: 14rpx;
}

.count-tile {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(39, 44, 68, 0.96), rgba(18, 22, 38, 0.96));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 -14rpx 18rpx rgba(73, 76, 150, 0.24), 0 8rpx 14rpx rgba(0, 0, 0, 0.32);
}

.count-tile.is-active {
  border-color: #e9c349;
  background: linear-gradient(180deg, rgba(53, 47, 88, 0.96), rgba(28, 26, 68, 0.96));
  box-shadow: 0 0 22rpx rgba(233, 195, 73, 0.24);
}

.count-tile__label {
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(190, 198, 224, 0.82);
}

.count-tile.is-active .count-tile__label {
  color: #f0d25a;
}

.call-editor {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.call-editor__card {
  height: 92rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 240, 218, 0.96);
  border: 2rpx solid rgba(208, 192, 155, 0.62);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.24);
}

.call-editor__card--count {
  width: 98rpx;
}

.call-editor__card--point {
  width: 98rpx;
  position: relative;
}

.call-editor__count {
  font-size: 62rpx;
  line-height: 1;
  font-weight: 900;
  color: #17100a;
}

.call-editor__unit {
  font-size: 32rpx;
  color: rgba(188, 198, 225, 0.78);
}

.call-editor__die {
  width: 54rpx;
  height: 54rpx;
}

.call-editor__arrow {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  color: #999;
}

.point-tile {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 27, 44, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.point-tile.is-active {
  border-color: #e9c349;
  box-shadow: 0 0 18rpx rgba(233, 195, 73, 0.22);
}

.point-tile__die {
  width: 44rpx;
  height: 44rpx;
}

.control-panel__foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.control-panel__foot-copy {
  flex: 1;
  font-size: 20rpx;
  color: rgba(187, 196, 225, 0.64);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.control-panel__foot-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.control-panel__foot-link {
  font-size: 22rpx;
  color: #f0cb53;
}

.control-voice-btn {
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 32, 78, 0.9);
  border: 1rpx solid rgba(120, 147, 246, 0.28);
  color: rgba(222, 230, 249, 0.84);
  font-size: 20rpx;
}

.room-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  padding: 48rpx 24rpx;
  background: rgba(8, 6, 18, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.room-entry-screen {
  position: relative;
  z-index: 20;
  min-height: 100vh;
  padding: calc(48rpx + env(safe-area-inset-top)) 24rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.room-sheet {
  width: 100%;
  max-height: 100%;
  border-radius: 30rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(32, 18, 54, 0.98), rgba(18, 12, 34, 0.98));
  border: 1rpx solid rgba(255, 224, 136, 0.18);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.room-sheet--settlement {
  background: linear-gradient(180deg, rgba(45, 39, 59, 0.96) 0%, rgba(29, 24, 40, 0.96) 100%);
  border-color: rgba(255, 255, 255, 0.1);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.52), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.room-sheet--seating {
  background: linear-gradient(180deg, rgba(45, 39, 59, 0.96) 0%, rgba(29, 24, 40, 0.96) 100%);
  border-color: rgba(255, 255, 255, 0.1);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.52), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f7f3e8;
}

.entry-sheet__headline {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

