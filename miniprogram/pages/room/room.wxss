/* Final call-panel readability pass: selectable and locked choices must read differently. */
.call-phase-panel__count:not(.is-disabled):not(.is-active),
.call-phase-panel__point-option:not(.is-disabled):not(.is-active) {
  border-color: rgba(235, 242, 250, 0.18);
