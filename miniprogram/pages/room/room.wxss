    0 10rpx 20rpx rgba(243, 205, 103, 0.08);
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.seat-grid-panel {
  padding: 14rpx;
}

.seat-grid__item {
  position: relative;
  overflow: hidden;
  min-height: 120rpx;
  padding: 14rpx 14rpx 12rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(180deg, rgba(12, 10, 25, 0.9) 0%, rgba(16, 14, 29, 0.78) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10rpx;
  box-sizing: border-box;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 10rpx 22rpx rgba(0, 0, 0, 0.16);
}

.seat-grid__item::after {
  content: "";
  position: absolute;
  top: 0;
  left: 16rpx;
  right: 16rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 244, 205, 0.2), rgba(255, 255, 255, 0));
}

.seat-grid__item.is-selected,
.seat-grid__item.hint-selected {
  border-color: rgba(243, 205, 103, 0.42);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 248, 220, 0.08),
    0 0 0 1rpx rgba(243, 205, 103, 0.16),
    0 14rpx 28rpx rgba(243, 205, 103, 0.12);
}

.seat-grid__item.hint-move-in,
.seat-grid__item.hint-move-out,
.seat-grid__item.hint-swap {
  border-color: rgba(90, 208, 255, 0.34);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05),
    0 12rpx 24rpx rgba(53, 148, 255, 0.08);
}

.seat-grid__item--pressing,
.seat-list-row__action--pressing,
.seat-submit--pressing {
  transform: scale(0.985);
  filter: brightness(0.98);
}

.seat-grid__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
}

.seat-grid__main {
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seat-grid__footer {
  display: flex;
  justify-content: flex-end;
}

.seat-topbar {
