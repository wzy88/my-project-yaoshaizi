<view class="page lobby-page {{devtoolsMode ? 'is-perf-lite' : ''}}">
  <view class="bg-layer bg-main"></view>
  <view class="bg-layer bg-pattern"></view>
  <image class="lobby-bg-art" src="{{homeTableBgAsset}}" mode="aspectFill"></image>
  <view class="bg-glow bg-glow--top"></view>
  <view class="bg-glow bg-glow--bottom"></view>
  <view class="bg-beam bg-beam--cyan"></view>
  <view class="bg-beam bg-beam--pink"></view>

  <image class="float-die float-die--a" src="{{floatDiceAssets[0]}}" mode="aspectFit"></image>
  <image class="float-die float-die--b" src="{{floatDiceAssets[1]}}" mode="aspectFit"></image>

  <view class="lobby-shell">
    <view class="hero-zone">
      <view class="home-logo-mask">
        <image class="home-logo" src="{{homeLogoAsset}}" mode="aspectFill"></image>
      </view>
      <view class="hero-profile-card" bindtap="goProfile">
        <view class="hero-profile-card__avatar">
          <image wx:if="{{avatarUrl}}" class="hero-profile-card__avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="hero-profile-card__avatar-text">{{nickname ? nickname.slice(0, 1) : '玩'}}</text>
        </view>
        <view class="hero-profile-card__copy">
          <text class="hero-profile-card__title">编号 {{profileDisplayNo}}</text>
          <text class="hero-profile-card__sub">查看个人主页</text>
        </view>
        <text class="hero-profile-card__arrow">›</text>
      </view>
      <view class="hero">
        <text class="hero-title">满上，</text>
        <text class="hero-title">来一局</text>
        <view class="hero-subline">
          <text class="hero-sub">摇骰吹牛，</text>
          <text class="hero-sub hero-sub--hot">满上开局！</text>
        </view>
      </view>
    </view>

    <view class="lobby-main">
      <view class="panel-stack">
        <view class="glass-card create-room-card">
          <view class="create-room-card__copy">
            <text class="create-room-card__title">创建房间</text>
            <text class="create-room-card__sub">邀请好友，一起满上！</text>
            <button class="create-room-card__btn" bindtap="goCreateRoom">
              <image class="create-room-card__btn-die" src="{{createButtonDieAsset}}" mode="aspectFit"></image>
              <text class="create-room-card__btn-text">创建新房间</text>
            </button>
          </view>
          <view class="create-room-card__cup">
            <image class="create-room-card__art" src="{{homeCreateArtAsset}}" mode="aspectFill"></image>
            <view class="create-room-card__cup-body">
              <view class="create-room-card__cup-ring create-room-card__cup-ring--top"></view>
              <view class="create-room-card__cup-mark"></view>
              <view class="create-room-card__cup-ring create-room-card__cup-ring--bottom"></view>
            </view>
            <view class="create-room-card__cup-light"></view>
            <image class="create-room-card__die create-room-card__die--one" src="{{floatDiceAssets[0]}}" mode="aspectFit"></image>
            <image class="create-room-card__die create-room-card__die--two" src="{{floatDiceAssets[1]}}" mode="aspectFit"></image>
            <image class="create-room-card__die create-room-card__die--three" src="{{createButtonDieAsset}}" mode="aspectFit"></image>
          </view>
        </view>

        <view class="glass-card join-card">
          <view class="join-card__copy">
            <text class="join-card__title">加入房间</text>
            <text class="join-card__sub">输入房间号，快速加入</text>
          </view>
          <view class="join-card__row">
            <input
              class="join-input"
              value="{{joinRoomId}}"
              bindinput="onJoinRoomIdChange"
              placeholder="输入房间号"
              maxlength="6"
              type="number"
              placeholder-class="join-placeholder"
            />
            <button class="join-btn" bindtap="goJoinRoom">
              <text class="join-btn__text">加入房间</text>
            </button>
          </view>
        </view>

        <view class="recent-section">
          <text class="recent-title">最近对局</text>
          <view class="recent-grid">
            <view wx:if="{{hasSession}}" class="glass-card recent-card" bindtap="goResume">
              <view class="recent-card__orb"></view>
              <text class="recent-card__code">{{sessionRoomId}}</text>
              <text class="recent-card__meta">点击继续上次房间</text>
            </view>
            <view wx:else class="glass-card recent-card is-empty">
              <text class="recent-card__code">----</text>
              <text class="recent-card__meta">暂无最近房间</text>
            </view>
            <view class="glass-card recent-card recent-card--secondary">
              <text class="recent-card__code recent-card__code--tip">规则</text>
              <text class="recent-card__meta">建议 4-8 人在线开局</text>
            </view>
          </view>
          <view wx:if="{{hasSession}}" class="recent-actions">
            <text class="recent-link" bindtap="goResume">继续房间</text>
            <text class="recent-link recent-link--danger" bindtap="clearSession">清空记录</text>
          </view>
        </view>
      </view>
    </view>

  </view>

  <view class="login-gate" wx:if="{{showLoginGate}}">
    <view class="login-gate__mask" bindtap="closeLoginGate"></view>
    <view class="login-gate__sheet" catchtap="noop">
      <view class="login-gate__glow login-gate__glow--a"></view>
      <view class="login-gate__glow login-gate__glow--b"></view>
      <view class="login-gate__handle"></view>
      <view class="login-gate__header">
        <text class="login-gate__eyebrow">ACCOUNT GATE</text>
        <text class="login-gate__title">{{loginGateTitle}}</text>
        <text class="login-gate__desc">{{loginGateDesc || '登录后会自动继续刚才的操作，不会打断组局流程。'}}</text>
      </view>
      <view class="login-gate__button-stack">
        <button class="login-gate__btn {{loginAgreementChecked ? '' : 'is-disabled'}}" loading="{{loginBusy}}" disabled="{{loginBusy || !loginAgreementChecked}}" bindtap="onWechatLogin">
          <text class="login-gate__btn-text">{{loginBusy ? '登录中...' : '微信登录并继续'}}</text>
        </button>
        <button class="login-gate__btn login-gate__btn--secondary" disabled="{{loginBusy}}" bindtap="closeLoginGate">
          <text class="login-gate__btn-text login-gate__btn-text--secondary">暂不登录</text>
        </button>
      </view>
      <view class="login-gate__agreement-row">
        <view class="login-gate__agreement-inline" bindtap="toggleLoginAgreement">
          <view class="login-gate__checkbox {{loginAgreementChecked ? 'is-checked' : ''}}">
            <text class="login-gate__checkbox-mark">✓</text>
          </view>
          <view class="login-gate__agreement-copy">
            <text class="login-gate__agreement-copy-text">我已阅读并同意</text>
            <text class="login-gate__link" catchtap="openTermsPage">《用户协议》</text>
            <text class="login-gate__agreement-copy-text">和</text>
            <text class="login-gate__link" catchtap="openPrivacyPage">《隐私政策》</text>
          </view>
        </view>
      </view>
      <view wx:if="{{connectionHintText}}" class="login-gate__connection">
        <text class="login-gate__connection-text">{{connectionHintText}}</text>
      </view>
    </view>
  </view>
</view>
