page {
  height: 100%;
  overflow: hidden;
}

.lobby-page {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #1c1326;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background:
    radial-gradient(circle at 50% 50%, rgba(42, 22, 61, 1) 0%, rgba(21, 8, 33, 1) 100%);
}

.bg-pattern {
  opacity: 0.2;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%),
    radial-gradient(circle at 0 0, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%);
  background-size: 188rpx 188rpx;
}

.bg-glow--top {
  top: -120rpx;
  left: -100rpx;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(120, 40, 160, 0.15) 0%, rgba(120, 40, 160, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -180rpx auto;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(40, 10, 80, 0.4) 0%, rgba(40, 10, 80, 0) 70%);
}

.float-die {
  position: absolute;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
  filter: drop-shadow(0 8rpx 18rpx rgba(0, 0, 0, 0.35));
  pointer-events: none;
}

.float-die--a {
  right: 16rpx;
  top: 156rpx;
  transform: rotate(8deg);
}

.float-die--b {
  left: 8rpx;
  top: 466rpx;
  transform: rotate(-10deg);
}

.lobby-shell,
.hero-zone,
.hero,
.lobby-main,
.panel-stack,
.login-gate {
  position: relative;
  z-index: 2;
}

.lobby-shell {
  height: 100%;
  padding: 0 26rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero-zone {
  flex-shrink: 0;
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 78rpx;
  line-height: 1.03;
  font-weight: 900;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.42);
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: #a8e6cf;
  font-size: 24rpx;
  letter-spacing: 0;
}

.lobby-main {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
}

.panel-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.glass-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.join-input {
  width: 100%;
  min-height: 64rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
}

.join-placeholder {
  color: rgba(255, 255, 255, 0.28);
}

.join-card {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.join-input {
  flex: 1;
  padding: 0 22rpx;
}

.join-btn {
  margin: 0;
  min-width: 168rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(154.53deg, #23b56f 0%, #14804c 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(20, 128, 76, 0.4);
}

.join-btn::after {
  border: 0;
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.join-btn__text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 800;
}

.recent-section {
  margin-top: 2rpx;
}

.recent-title {
  display: block;
  margin-bottom: 14rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

