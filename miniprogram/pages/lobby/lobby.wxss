page {
  height: 100%;
  overflow: hidden;
}

.lobby-page {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #1c1326;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background:
    radial-gradient(circle at 50% 50%, rgba(42, 22, 61, 1) 0%, rgba(21, 8, 33, 1) 100%);
}

.bg-pattern {
  opacity: 0.2;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%),
    radial-gradient(circle at 0 0, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%);
  background-size: 188rpx 188rpx;
}

.bg-glow--top {
  top: -120rpx;
  left: -100rpx;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(120, 40, 160, 0.15) 0%, rgba(120, 40, 160, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -180rpx auto;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(40, 10, 80, 0.4) 0%, rgba(40, 10, 80, 0) 70%);
}

.float-die {
  position: absolute;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
  filter: drop-shadow(0 8rpx 18rpx rgba(0, 0, 0, 0.35));
  pointer-events: none;
}

.float-die--a {
  right: 16rpx;
  top: 156rpx;
  transform: rotate(8deg);
}

.float-die--b {
  left: 8rpx;
  top: 466rpx;
  transform: rotate(-10deg);
}

.lobby-shell,
.hero-zone,
.hero,
.lobby-main,
.panel-stack,
.login-gate {
  position: relative;
  z-index: 2;
}

.lobby-shell {
  height: 100%;
  padding: 0 20rpx calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero-zone {
  flex-shrink: 0;
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 78rpx;
  line-height: 1.03;
  font-weight: 900;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.42);
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: #a8e6cf;
  font-size: 24rpx;
  letter-spacing: 0;
}

.lobby-main {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
}

.panel-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.glass-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.join-input {
  width: 100%;
  min-height: 64rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
}

.join-placeholder {
  color: rgba(255, 255, 255, 0.28);
}

.join-card {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.join-input {
  flex: 1;
  padding: 0 22rpx;
}

.join-btn {
  margin: 0;
  min-width: 168rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(154.53deg, #23b56f 0%, #14804c 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(20, 128, 76, 0.4);
}

.join-btn::after {
  border: 0;
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.join-btn__text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 800;
}

.recent-section {
  margin-top: 2rpx;
}

.recent-title {
  display: block;
  margin-bottom: 14rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.recent-grid {
  display: flex;
  gap: 14rpx;
}

.recent-card {
  flex: 1;
  min-height: 148rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.recent-card--secondary {
  opacity: 0.92;
}

.recent-card.is-empty {
  opacity: 0.72;
}

.recent-card__orb {
  position: absolute;
  top: -18rpx;
  right: -8rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(35, 181, 111, 0.12);
  filter: blur(10rpx);
}

.recent-card__code {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.recent-card__code--tip {
  color: #23b56f;
}

.recent-card__meta {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(232, 245, 233, 0.62);
  font-size: 19rpx;
  line-height: 1.45;
}

.recent-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 4rpx;
}

.recent-link {
  color: #a8e6cf;
  font-size: 22rpx;
}

.recent-link--danger {
  color: rgba(255, 107, 107, 0.9);
}

.lobby-page {
  background: #050616;
}

.bg-main {
  background:
    radial-gradient(circle at 50% 3%, rgba(57, 45, 142, 0.82), rgba(12, 8, 40, 0.18) 34%, rgba(5, 6, 22, 0) 58%),
    radial-gradient(circle at 22% 60%, rgba(61, 209, 255, 0.2), rgba(61, 209, 255, 0) 26%),
    radial-gradient(circle at 90% 44%, rgba(255, 66, 223, 0.22), rgba(255, 66, 223, 0) 30%),
    linear-gradient(180deg, #08051d 0%, #050616 54%, #07091b 100%);
}

.bg-pattern {
  opacity: 0.12;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(117, 73, 255, 0.7) 0, rgba(117, 73, 255, 0.22) 10%, transparent 28%),
    radial-gradient(circle at 0 0, rgba(28, 196, 255, 0.5) 0, rgba(28, 196, 255, 0.14) 12%, transparent 30%);
  background-size: 210rpx 210rpx;
}

.bg-glow--top {
  top: -160rpx;
  left: -130rpx;
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(84, 77, 255, 0.3) 0%, rgba(84, 77, 255, 0) 68%);
}

.bg-glow--bottom {
  inset: auto -150rpx -220rpx auto;
  width: 680rpx;
  height: 680rpx;
  background: radial-gradient(circle, rgba(222, 68, 255, 0.22) 0%, rgba(222, 68, 255, 0) 72%);
}

.bg-beam {
  position: absolute;
  z-index: 1;
  height: 6rpx;
  border-radius: 999rpx;
  pointer-events: none;
}

.bg-beam--cyan {
  left: -72rpx;
  top: 312rpx;
  width: 246rpx;
  background: linear-gradient(90deg, rgba(63, 220, 255, 0), rgba(63, 220, 255, 0.96));
  box-shadow: 0 0 34rpx rgba(63, 220, 255, 0.7);
  transform: rotate(-42deg);
}

.bg-beam--pink {
  right: -42rpx;
  top: 382rpx;
  width: 264rpx;
  background: linear-gradient(90deg, rgba(255, 70, 221, 0.95), rgba(255, 70, 221, 0));
  box-shadow: 0 0 34rpx rgba(255, 70, 221, 0.72);
  transform: rotate(-38deg);
}

.float-die {
  opacity: 0.28;
  filter: drop-shadow(0 10rpx 24rpx rgba(30, 192, 255, 0.3));
}

.float-die--a {
  right: 22rpx;
  top: 142rpx;
}

.float-die--b {
  left: 10rpx;
  top: 388rpx;
}

.hero-zone {
  height: 424rpx;
  margin-left: -20rpx;
  margin-right: -20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-logo {
  position: absolute;
  left: 50%;
  top: 0;
  width: 100vw;
  height: 424rpx;
  transform: translateX(-50%);
  filter: drop-shadow(0 24rpx 42rpx rgba(0, 0, 0, 0.72));
}

.hero {
  position: absolute;
  left: 20rpx;
  bottom: 12rpx;
  opacity: 0.01;
  pointer-events: none;
}

.hero-title {
  font-size: 2rpx;
  line-height: 1;
}

.hero-sub {
  margin-top: 0;
  font-size: 2rpx;
}

.lobby-main {
  margin-top: 22rpx;
}

.panel-stack {
  gap: 22rpx;
}

.create-room-card {
  min-height: 254rpx;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 75% 42%, rgba(82, 126, 255, 0.56), rgba(82, 126, 255, 0) 38%),
    radial-gradient(circle at 16% 20%, rgba(216, 88, 255, 0.35), rgba(216, 88, 255, 0) 46%),
    linear-gradient(135deg, rgba(93, 48, 134, 0.9) 0%, rgba(24, 21, 94, 0.94) 58%, rgba(10, 25, 72, 0.94) 100%);
  border-color: rgba(190, 104, 255, 0.76);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.1),
    inset 0 0 58rpx rgba(93, 107, 255, 0.24),
    0 18rpx 42rpx rgba(2, 3, 17, 0.52),
    0 0 34rpx rgba(131, 74, 255, 0.44);
}

.create-room-card__copy {
  position: relative;
  z-index: 2;
  width: 344rpx;
}

.create-room-card__title {
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.42);
}

.create-room-card__sub {
  display: block;
  margin-top: 14rpx;
  color: rgba(232, 226, 255, 0.6);
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.create-room-card__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 266rpx;
  height: 74rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #cf4fff 0%, #8e31d8 48%, #5a24a9 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.32),
    0 12rpx 24rpx rgba(35, 2, 80, 0.45),
    0 0 20rpx rgba(225, 83, 255, 0.46);
}

.create-room-card__btn::after {
  border: 0;
}

.create-room-card__btn-die {
  width: 34rpx;
  height: 34rpx;
}

.create-room-card__btn-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.create-room-card__cup {
  position: absolute;
  right: -10rpx;
  top: -34rpx;
  width: 300rpx;
  height: 286rpx;
}

.create-room-card__cup-body {
  position: absolute;
  right: 40rpx;
  top: 0;
  width: 154rpx;
  height: 190rpx;
  border-radius: 54rpx 54rpx 44rpx 44rpx;
  background:
    radial-gradient(circle at 35% 26%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 24%),
    linear-gradient(150deg, #3a2d76 0%, #211943 45%, #150f2d 100%);
  box-shadow:
    inset -16rpx -12rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 14rpx 10rpx 22rpx rgba(135, 95, 255, 0.24),
    0 14rpx 32rpx rgba(0, 0, 0, 0.48);
  transform: rotate(18deg);
}

.create-room-card__cup-ring {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #64d7ff;
  box-shadow: 0 0 20rpx rgba(100, 215, 255, 0.86);
}

.create-room-card__cup-ring--top {
  top: 32rpx;
}

.create-room-card__cup-ring--bottom {
  left: -16rpx;
  right: -16rpx;
  bottom: 18rpx;
}

.create-room-card__cup-mark {
  position: absolute;
  left: 42rpx;
  top: 76rpx;
  width: 60rpx;
  height: 48rpx;
  border: 5rpx solid rgba(170, 98, 255, 0.26);
  border-radius: 16rpx;
  transform: rotate(20deg);
}

.create-room-card__cup-light {
  position: absolute;
  right: 18rpx;
  bottom: 34rpx;
  width: 228rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(70, 207, 255, 0.66), rgba(130, 66, 255, 0.22) 48%, rgba(130, 66, 255, 0));
  filter: blur(8rpx);
}

.create-room-card__die {
  position: absolute;
  z-index: 3;
  width: 74rpx;
  height: 74rpx;
  filter: drop-shadow(0 10rpx 16rpx rgba(0, 0, 0, 0.42));
}

.create-room-card__die--one {
  right: 132rpx;
  bottom: 34rpx;
  transform: rotate(-13deg);
}

.create-room-card__die--two {
  right: 68rpx;
  bottom: 64rpx;
  transform: rotate(12deg);
}

.create-room-card__die--three {
  right: 16rpx;
  bottom: 36rpx;
  transform: rotate(18deg);
}

.recent-section {
  display: none;
}

.join-card {
  padding: 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(126, 212, 255, 0.18);
}

.join-input {
  min-height: 58rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.join-btn {
  min-width: 158rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #33d8ff 0%, #147dff 100%);
  box-shadow: 0 12rpx 26rpx rgba(19, 124, 255, 0.3);
}

.join-btn__text {
  font-size: 25rpx;
}

.login-gate {
  position: fixed;
  inset: 0;
  z-index: 10020;
}

.login-gate__mask {
  position: absolute;
  inset: 0;
  background: rgba(8, 9, 16, 0.52);
  backdrop-filter: blur(10rpx);
}

.login-gate__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  min-height: 460rpx;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 0%, rgba(244, 203, 95, 0.11) 0%, rgba(244, 203, 95, 0) 26%),
    radial-gradient(circle at 0% 100%, rgba(34, 185, 111, 0.1) 0%, rgba(34, 185, 111, 0) 34%),
    linear-gradient(180deg, rgba(22, 20, 36, 0.985), rgba(13, 15, 26, 0.97));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 24rpx 62rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(10rpx);
  pointer-events: none;
}

.login-gate__glow--a {
  width: 180rpx;
  height: 180rpx;
  top: -74rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(244, 203, 95, 0.18) 0%, rgba(244, 203, 95, 0) 72%);
}

.login-gate__glow--b {
  width: 200rpx;
  height: 200rpx;
  left: -72rpx;
  bottom: -92rpx;
  background: radial-gradient(circle, rgba(35, 181, 111, 0.14) 0%, rgba(35, 181, 111, 0) 76%);
}

.login-gate__handle {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  margin: 0 auto 24rpx;
}

.login-gate__header {
  position: relative;
  z-index: 1;
  text-align: center;
}

.login-gate__title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(232, 240, 235, 0.56);
  font-size: 22rpx;
  line-height: 1.4;
}

.login-gate__profile-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.login-gate__profile-avatar-text {
  color: #fff2c7;
  font-size: 34rpx;
  font-weight: 900;
}

.login-gate__button-stack {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.login-gate__agreement-row {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 0;
}

.login-gate__agreement-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  max-width: 100%;
}

.login-gate__checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(214, 224, 243, 0.22);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.login-gate__checkbox.is-checked {
  border-color: rgba(244, 205, 106, 0.72);
  background: linear-gradient(180deg, #f7db76 0%, #e9c349 100%);
  box-shadow: 0 8rpx 18rpx rgba(233, 195, 73, 0.2);
}

.login-gate__checkbox-mark {
  color: transparent;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.login-gate__checkbox.is-checked .login-gate__checkbox-mark {
  color: #3b250c;
}

.login-gate__agreement-copy {
  flex: 0 1 auto;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  display: flex;
  text-align: center;
}

.login-gate__agreement-copy-text {
  color: rgba(232, 240, 235, 0.68);
  font-size: 22rpx;
  line-height: 1.5;
}

.login-gate__btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 94rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 248, 216, 0.54) 0%, rgba(255, 248, 216, 0) 34%),
    linear-gradient(180deg, #f8e2a6 0%, #f0cc72 48%, #dca93d 100%);
  box-shadow:
    0 16rpx 34rpx rgba(214, 164, 57, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.login-gate__btn.is-disabled {
  background: linear-gradient(180deg, rgba(152, 162, 189, 0.4) 0%, rgba(112, 123, 147, 0.3) 100%);
  box-shadow: none;
}

.login-gate__btn--secondary {
  background: linear-gradient(180deg, rgba(58, 63, 82, 0.92) 0%, rgba(34, 37, 50, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 14rpx 28rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.login-gate__btn::after {
  border: 0;
}

.login-gate__btn-text {
  color: #2e2106;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.login-gate__btn-text--secondary {
  color: rgba(244, 247, 251, 0.88);
}

.login-gate__connection {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
}

.login-gate__connection-text {
  color: rgba(232, 240, 235, 0.68);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.login-gate__link {
  color: #f6d36f;
}

.lobby-page.is-perf-lite .bg-glow,
.lobby-page.is-perf-lite .float-die,
.lobby-page.is-perf-lite .login-gate__glow {
  display: none;
}

.lobby-page.is-perf-lite .glass-card,
.lobby-page.is-perf-lite .join-btn,
.lobby-page.is-perf-lite .login-gate__sheet,
.lobby-page.is-perf-lite .login-gate__btn,
.lobby-page.is-perf-lite .login-gate__secondary,
.lobby-page.is-perf-lite .login-gate__mask,
.lobby-page.is-perf-lite .recent-card,
.lobby-page.is-perf-lite .recent-link {
  animation: none !important;
  transition: none !important;
}

.lobby-page.is-perf-lite .glass-card,
.lobby-page.is-perf-lite .join-btn,
.lobby-page.is-perf-lite .login-gate__sheet,
.lobby-page.is-perf-lite .login-gate__btn,
.lobby-page.is-perf-lite .login-gate__secondary {
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.18);
}

.lobby-page.is-perf-lite .login-gate__mask {
  backdrop-filter: none;
}

.lobby-page.is-perf-lite .glass-card,
.lobby-page.is-perf-lite .login-gate__sheet {
  background: rgba(18, 20, 31, 0.96);
}
