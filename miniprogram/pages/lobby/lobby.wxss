page {
  height: 100%;
  overflow: hidden;
}

.lobby-page {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #1c1326;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background:
    radial-gradient(circle at 50% 50%, rgba(42, 22, 61, 1) 0%, rgba(21, 8, 33, 1) 100%);
}

.bg-pattern {
  opacity: 0.2;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%),
    radial-gradient(circle at 0 0, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%);
  background-size: 188rpx 188rpx;
}

.bg-glow--top {
  top: -120rpx;
  left: -100rpx;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(120, 40, 160, 0.15) 0%, rgba(120, 40, 160, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -180rpx auto;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(40, 10, 80, 0.4) 0%, rgba(40, 10, 80, 0) 70%);
}

.float-die {
  position: absolute;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
  filter: drop-shadow(0 8rpx 18rpx rgba(0, 0, 0, 0.35));
  pointer-events: none;
}

.float-die--a {
  right: 16rpx;
  top: 156rpx;
  transform: rotate(8deg);
}

.float-die--b {
  left: 8rpx;
  top: 466rpx;
  transform: rotate(-10deg);
}

.lobby-shell,
.hero-zone,
.hero,
.lobby-main,
.panel-stack,
.bottom-action,
.login-gate {
  position: relative;
  z-index: 2;
}

.lobby-shell {
  height: 100%;
  padding: calc(88rpx + env(safe-area-inset-top)) 20rpx calc(176rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero-zone {
  flex-shrink: 0;
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 78rpx;
  line-height: 1.03;
  font-weight: 900;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.42);
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: #a8e6cf;
  font-size: 24rpx;
  letter-spacing: 0;
}

.lobby-main {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
}

.panel-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.glass-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.join-input {
  width: 100%;
  min-height: 64rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
}

.join-placeholder {
  color: rgba(255, 255, 255, 0.28);
}

.profile-card {
  padding: 24rpx 26rpx;
}

.profile-card__main {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-card__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background:
    radial-gradient(circle at 30% 28%, rgba(182, 236, 212, 0.28) 0%, rgba(182, 236, 212, 0.08) 30%, rgba(255, 255, 255, 0.06) 100%);
  border: 2rpx solid rgba(167, 229, 201, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 10rpx 22rpx rgba(8, 10, 24, 0.26),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.profile-card__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.profile-card__avatar-text {
  color: #fff2c7;
  font-size: 38rpx;
  font-weight: 900;
}

.profile-card__text {
  flex: 1;
  min-width: 0;
}

.profile-card__label {
  display: block;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.profile-card__name {
  display: block;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-card__hint {
  display: block;
  margin-top: 10rpx;
  color: rgba(232, 240, 235, 0.66);
  font-size: 22rpx;
  line-height: 1.6;
}

.join-card {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.join-input {
  flex: 1;
  padding: 0 22rpx;
}

.join-btn {
  margin: 0;
  min-width: 168rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(154.53deg, #23b56f 0%, #14804c 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(20, 128, 76, 0.4);
}

.join-btn::after {
  border: 0;
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.join-btn__text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 800;
}

.recent-section {
  margin-top: 2rpx;
}

.recent-title {
  display: block;
  margin-bottom: 14rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.recent-grid {
  display: flex;
  gap: 14rpx;
}

.recent-card {
  flex: 1;
  min-height: 148rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.recent-card--secondary {
  opacity: 0.92;
}

.recent-card.is-empty {
  opacity: 0.72;
}

.recent-card__orb {
  position: absolute;
  top: -18rpx;
  right: -8rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(35, 181, 111, 0.12);
  filter: blur(10rpx);
}

.recent-card__code {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.recent-card__code--tip {
  color: #23b56f;
}

.recent-card__meta {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(232, 245, 233, 0.62);
  font-size: 19rpx;
  line-height: 1.45;
}

.recent-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 4rpx;
}

.recent-link {
  color: #a8e6cf;
  font-size: 22rpx;
}

.recent-link--danger {
  color: rgba(255, 107, 107, 0.9);
}

.bottom-action {
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 24rpx;
}

.create-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(170.99deg, #23b56f 0%, #1a965a 50%, #14804c 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(20, 128, 76, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.create-btn::after {
  border: 0;
}

.create-btn__die {
  width: 34rpx;
  height: 34rpx;
}

.create-btn__text {
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.login-gate {
  position: fixed;
  inset: 0;
  z-index: 10020;
}

.login-gate__mask {
  position: absolute;
  inset: 0;
  background: rgba(8, 9, 16, 0.52);
  backdrop-filter: blur(10rpx);
}

.login-gate__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  padding: 22rpx 22rpx 30rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(180deg, rgba(18, 20, 31, 0.98), rgba(14, 16, 27, 0.94)),
    rgba(14, 16, 27, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.26);
}

.login-gate__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  margin: 0 auto 18rpx;
}

.login-gate__title {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.login-gate__desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(232, 240, 235, 0.7);
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.login-gate__btn {
  margin-top: 24rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffe17e 0%, #e9c349 100%);
  box-shadow: 0 12rpx 32rpx rgba(233, 195, 73, 0.28);
}

.login-gate__btn::after {
  border: 0;
}

.login-gate__btn-text {
  color: #2f2207;
  font-size: 30rpx;
  font-weight: 800;
}

.login-gate__hint {
  display: block;
  margin-top: 14rpx;
  color: rgba(232, 240, 235, 0.64);
  font-size: 22rpx;
  text-align: center;
  line-height: 1.5;
}

.login-gate__connection {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
}

.login-gate__connection-text {
  color: rgba(232, 240, 235, 0.68);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.login-gate__agreement {
  display: block;
  margin-top: 18rpx;
  color: rgba(232, 240, 235, 0.52);
  font-size: 20rpx;
  text-align: center;
  line-height: 1.6;
}

.login-gate__link {
  color: #a8e6cf;
}
