.lobby-page {
  position: relative;
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 20rpx calc(306rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: #1c1326;
}

.bg-layer,
.bg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-main {
  background:
    radial-gradient(circle at 50% 50%, rgba(42, 22, 61, 1) 0%, rgba(21, 8, 33, 1) 100%);
}

.bg-pattern {
  opacity: 0.2;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%),
    radial-gradient(circle at 0 0, rgba(66, 32, 94, 1) 0, rgba(33, 16, 47, 0.5) 15%, transparent 30%);
  background-size: 188rpx 188rpx;
}

.bg-glow--top {
  top: -120rpx;
  left: -100rpx;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(120, 40, 160, 0.15) 0%, rgba(120, 40, 160, 0) 70%);
}

.bg-glow--bottom {
  inset: auto -120rpx -180rpx auto;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(40, 10, 80, 0.4) 0%, rgba(40, 10, 80, 0) 70%);
}

.float-die {
  position: absolute;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
  filter: drop-shadow(0 8rpx 18rpx rgba(0, 0, 0, 0.35));
  pointer-events: none;
}

.float-die--a {
  right: 16rpx;
  top: 156rpx;
  transform: rotate(8deg);
}

.float-die--b {
  left: 8rpx;
  top: 466rpx;
  transform: rotate(-10deg);
}

.status-row,
.hero,
.panel-stack,
.bottom-action {
  position: relative;
  z-index: 2;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-time {
  color: #e8f5e9;
  font-size: 30rpx;
  font-weight: 700;
}

.status-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-pill,
.status-signal {
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-pill {
  min-width: 70rpx;
  padding: 0 18rpx;
  color: #e8f5e9;
  font-size: 20rpx;
  font-weight: 700;
}

.status-signal {
  width: 52rpx;
}

.status-signal__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #23b56f;
  box-shadow: 0 0 14rpx rgba(35, 181, 111, 0.9);
}

.hero {
  margin-top: 28rpx;
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 82rpx;
  line-height: 1.08;
  font-weight: 900;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.42);
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  color: #a8e6cf;
  font-size: 24rpx;
  letter-spacing: 0;
}

.panel-stack {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.glass-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.input-card {
  padding: 26rpx 28rpx 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.field-input,
.join-input {
  width: 100%;
  min-height: 64rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
}

.field-placeholder,
.join-placeholder {
  color: rgba(255, 255, 255, 0.28);
}

.join-card {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.join-input {
  flex: 1;
  padding: 0 22rpx;
}

.join-btn {
  margin: 0;
  min-width: 168rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(154.53deg, #23b56f 0%, #14804c 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(20, 128, 76, 0.4);
}

.join-btn::after {
  border: 0;
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.join-btn__text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 800;
}

.recent-section {
  margin-top: 4rpx;
}

.recent-title {
  display: block;
  margin-bottom: 14rpx;
  color: #a8e6cf;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.recent-grid {
  display: flex;
  gap: 14rpx;
}

.recent-card {
  flex: 1;
  min-height: 156rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.recent-card--secondary {
  opacity: 0.92;
}

.recent-card.is-empty {
  opacity: 0.72;
}

.recent-card__orb {
  position: absolute;
  top: -18rpx;
  right: -8rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(35, 181, 111, 0.12);
  filter: blur(10rpx);
}

.recent-card__code {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.recent-card__code--tip {
  color: #23b56f;
}

.recent-card__meta {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(232, 245, 233, 0.62);
  font-size: 19rpx;
  line-height: 1.45;
}

.recent-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 4rpx;
}

.recent-link {
  color: #a8e6cf;
  font-size: 22rpx;
}

.recent-link--danger {
  color: rgba(255, 107, 107, 0.9);
}

.bottom-action {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.create-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(170.99deg, #23b56f 0%, #1a965a 50%, #14804c 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(20, 128, 76, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.create-btn::after {
  border: 0;
}

.create-btn__die {
  width: 34rpx;
  height: 34rpx;
}

.create-btn__text {
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.legal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.62);
}

.legal-modal {
  width: 100%;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, rgba(30, 22, 40, 0.98), rgba(20, 15, 30, 0.98));
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 -18rpx 40rpx rgba(0, 0, 0, 0.45);
  padding: 24rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
}

.legal-modal__handle {
  width: 82rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
  background: rgba(255, 255, 255, 0.15);
}

.legal-title {
  display: block;
  text-align: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.legal-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(232, 245, 233, 0.72);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.legal-links {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 18rpx;
}

.legal-link {
  color: #23b56f;
  font-size: 24rpx;
  font-weight: 700;
}

.legal-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.legal-btn--primary {
  background: linear-gradient(135deg, #23b56f 0%, #14804c 100%);
  color: #ffffff;
}

.legal-btn--ghost {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.68);
}

.join-btn:active,
.create-btn:active,
.recent-card:active,
.recent-link:active,
.legal-link:active,
.legal-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}
