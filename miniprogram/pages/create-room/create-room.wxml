<view class="page create-page {{devtoolsMode ? 'is-perf-lite' : ''}}">
  <view class="mask-bg"></view>
  <view class="bg-beam bg-beam--cyan"></view>
  <view class="bg-beam bg-beam--pink"></view>
  <image class="float-die float-die--a" src="{{floatDiceAssets[0]}}" mode="aspectFit"></image>
  <image class="float-die float-die--b" src="{{floatDiceAssets[1]}}" mode="aspectFit"></image>
  <view class="create-sheet">
    <view class="create-sheet__handle"></view>
    <view class="create-sheet__glow create-sheet__glow--a"></view>
    <view class="create-sheet__glow create-sheet__glow--b"></view>
    <view class="create-sheet__head">
      <view class="create-sheet__heading">
        <text class="create-sheet__eyebrow">ROOM SETUP</text>
        <text class="create-sheet__title">创建房间</text>
        <text class="create-sheet__desc">先定主题和通配规则，创建后直接进入房间。</text>
      </view>
      <view class="create-sheet__summary">
        <view class="create-sheet__summary-item">
          <text class="create-sheet__summary-value">8</text>
          <text class="create-sheet__summary-label">固定座位</text>
        </view>
        <view class="create-sheet__summary-item">
          <text class="create-sheet__summary-value">5</text>
          <text class="create-sheet__summary-label">每人骰子</text>
        </view>
        <view class="create-sheet__summary-item">
          <text class="create-sheet__summary-value">{{wildcardOneEnabled ? '开' : '关'}}</text>
          <text class="create-sheet__summary-label">通配 1</text>
        </view>
      </view>
    </view>

    <scroll-view class="create-sheet__scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="create-sheet__body">
        <view class="block block--hero">
          <text class="block-title">房间形式</text>
          <view class="room-form-card">
            <view class="room-form-card__glow"></view>
            <view class="room-form-card__badge">固定房间</view>
            <text class="room-form-card__title">固定 8 个座位</text>
            <text class="room-form-card__desc">房间始终保留 8 个座位，来几个人算几个人，最多 8 人同局。</text>
          </view>
        </view>

        <view class="block">
          <text class="block-title">房间主题</text>
          <view class="theme-picker">
            <block wx:for="{{roomThemeOptions}}" wx:key="id">
              <view
                class="theme-card theme-card--{{item.id}} {{themePreviewId === item.id ? 'is-active' : ''}}"
                data-theme-id="{{item.id}}"
                bindtap="onSelectTheme"
              >
                <view class="theme-card__check {{themePreviewId === item.id ? 'is-active' : ''}}">{{item.badge}}</view>
                <view class="theme-card__preview"></view>
                <view class="theme-card__meta">
                  <text class="theme-card__title">{{item.label}}</text>
                </view>
              </view>
            </block>
          </view>
        </view>

        <view class="block">
          <text class="block-title">局内规则</text>
          <view class="toggle-card" data-field="wildcardOneEnabled" bindtap="onToggleField">
            <view class="toggle-card__signal {{wildcardOneEnabled ? 'is-on' : 'is-off'}}"></view>
            <view class="toggle-copy">
              <text class="toggle-title">通配 1</text>
              <text class="toggle-sub">有人叫 1 之后通配效果失效</text>
            </view>
            <view class="toggle-pill {{wildcardOneEnabled ? 'is-on' : ''}}">
              <view class="toggle-pill__thumb"></view>
            </view>
          </view>
        </view>

        <view class="create-note-card">
          <text class="create-note-card__title">本次配置</text>
          <text class="create-note-card__desc">固定 8 个座位，每人 5 颗骰子，当前使用 {{themePreviewLabel}} 主题。空位会保留杯位，但不会显示头像。</text>
        </view>
      </view>
    </scroll-view>

    <view class="create-sheet__footer">
      <view class="create-actions">
        <button class="create-btn" bindtap="createAndEnter">创建并进入</button>
        <button class="cancel-btn" bindtap="back">取消</button>
      </view>
    </view>
  </view>
</view>
