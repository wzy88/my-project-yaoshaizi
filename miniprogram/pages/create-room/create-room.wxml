<view class="page create-page">
  <view class="mask-bg"></view>
  <view class="panel">
    <view class="panel-handle"></view>
    <view class="panel-title">
      <text class="panel-title__icon">🎲</text>
      <text class="panel-title__text">创建房间</text>
    </view>

    <view class="block">
      <text class="block-title">房间人数</text>
      <view class="chip-row">
        <block wx:for="{{playerCountOptions}}" wx:key="*this">
          <view
            class="chip {{playerCount === item ? 'active' : ''}} is-disabled"
          >{{item}}</view>
        </block>
      </view>
      <text class="block-hint">暂未开放自定义，当前固定 8 人房。</text>
    </view>

    <view class="toggle-card is-disabled">
      <view class="toggle-copy">
        <text class="toggle-title">允许旁观</text>
        <text class="toggle-sub">暂未开放，当前默认关闭。</text>
      </view>
      <view class="toggle-pill {{allowSpectator ? 'is-on' : ''}} is-disabled">
        <view class="toggle-pill__thumb"></view>
      </view>
    </view>

    <view class="toggle-card is-disabled">
      <view class="toggle-copy">
        <text class="toggle-title">锁定房间</text>
        <text class="toggle-sub">暂未开放，当前默认关闭。</text>
      </view>
      <view class="toggle-pill {{lockRoom ? 'is-on' : ''}} is-disabled">
        <view class="toggle-pill__thumb"></view>
      </view>
    </view>

    <view class="toggle-card" data-field="wildcardOneEnabled" bindtap="onToggleField">
      <view class="toggle-copy">
        <text class="toggle-title">通配 1</text>
        <text class="toggle-sub">有人叫 1 之后通配效果失效</text>
      </view>
      <view class="toggle-pill {{wildcardOneEnabled ? 'is-on' : ''}}">
        <view class="toggle-pill__thumb"></view>
      </view>
    </view>

    <text class="panel-note">默认每人 5 颗骰子，按当前规则创建后会直接进入房间。</text>

    <button class="create-btn" bindtap="createAndEnter">创建并进入</button>
    <button class="cancel-btn" bindtap="back">取消</button>
  </view>
</view>
