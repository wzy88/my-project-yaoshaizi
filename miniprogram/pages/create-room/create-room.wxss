.create-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: calc(48rpx + env(safe-area-inset-top)) 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% -18%, rgba(122, 58, 162, 0.3) 0%, rgba(122, 58, 162, 0) 46%),
    radial-gradient(circle at 100% 100%, rgba(35, 181, 111, 0.14) 0%, rgba(35, 181, 111, 0) 36%),
    linear-gradient(180deg, #1d1328 0%, #150c20 100%);
}

.mask-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 40rpx 40rpx, rgba(66, 32, 94, 0.32) 0, rgba(66, 32, 94, 0.32) 4rpx, transparent 5rpx);
  background-size: 96rpx 96rpx;
  opacity: 0.45;
  pointer-events: none;
}

.create-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 682rpx;
  height: min(1320rpx, calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 84rpx));
  max-height: min(1320rpx, calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 84rpx));
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 8% 0%, rgba(245, 219, 126, 0.16) 0%, rgba(245, 219, 126, 0.03) 42%, rgba(245, 219, 126, 0) 58%),
    radial-gradient(circle at 100% 100%, rgba(42, 190, 112, 0.14) 0%, rgba(42, 190, 112, 0) 58%),
    linear-gradient(180deg, rgba(34, 29, 55, 0.98) 0%, rgba(17, 14, 29, 0.99) 100%);
  border: 1rpx solid rgba(245, 221, 140, 0.16);
  box-shadow:
    0 30rpx 82rpx rgba(0, 0, 0, 0.56),
    inset 0 1rpx 0 rgba(255, 248, 220, 0.12),
    inset 0 -24rpx 40rpx rgba(0, 0, 0, 0.18),
    0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.create-sheet__glow {
  position: absolute;
  pointer-events: none;
  border-radius: 999rpx;
  filter: blur(10rpx);
  opacity: 0.9;
}

.create-sheet__glow--a {
  width: 220rpx;
  height: 220rpx;
  top: -84rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(244, 203, 95, 0.34) 0%, rgba(244, 203, 95, 0) 72%);
}

.create-sheet__glow--b {
  width: 240rpx;
  height: 240rpx;
  left: -68rpx;
  bottom: -92rpx;
  background: radial-gradient(circle, rgba(41, 186, 119, 0.2) 0%, rgba(41, 186, 119, 0) 74%);
}

.create-sheet__head {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  padding: 30rpx 28rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 244, 205, 0.08);
}

.create-sheet__heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.create-sheet__eyebrow {
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: rgba(240, 201, 102, 0.9);
}

.create-sheet__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #f7f3e8;
}

.create-sheet__desc {
  font-size: 22rpx;
  line-height: 1.65;
  color: rgba(214, 222, 244, 0.76);
}

.create-sheet__scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.create-sheet__body {
  position: relative;
  padding: 24rpx 28rpx 30rpx;
  box-sizing: border-box;
}

.create-sheet__footer {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  padding: 18rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 244, 205, 0.08);
  background:
    linear-gradient(180deg, rgba(17, 14, 29, 0.04) 0%, rgba(17, 14, 29, 0.92) 22%, rgba(17, 14, 29, 0.98) 100%);
  backdrop-filter: blur(12rpx);
}

.block + .block {
  margin-top: 18rpx;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(240, 201, 102, 0.82);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.room-form-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(245, 219, 126, 0.14) 0%, rgba(245, 219, 126, 0) 44%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.018) 100%);
  border: 1rpx solid rgba(246, 220, 132, 0.12);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 14rpx 28rpx rgba(0, 0, 0, 0.16);
}

.room-form-card__glow {
  position: absolute;
  top: -44rpx;
  right: -10rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(243, 205, 103, 0.18) 0, rgba(243, 205, 103, 0) 72%);
  pointer-events: none;
}

.room-form-card__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(243, 205, 103, 0.22), rgba(243, 205, 103, 0.12));
  border: 1rpx solid rgba(243, 205, 103, 0.32);
  color: #f8d36c;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 16rpx rgba(243, 205, 103, 0.12);
}

.room-form-card__title {
  position: relative;
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.room-form-card__desc {
  position: relative;
  display: block;
  margin-top: 10rpx;
  color: rgba(214, 222, 244, 0.74);
  font-size: 22rpx;
  line-height: 1.6;
}

.toggle-card,
.create-note-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.018) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05),
    0 12rpx 24rpx rgba(0, 0, 0, 0.14);
}

.theme-picker {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.theme-card {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 12rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(248, 244, 232, 0.055) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 1rpx solid rgba(255, 245, 214, 0.08);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 12rpx 24rpx rgba(0, 0, 0, 0.16);
}

.theme-card.is-active {
  border-color: rgba(243, 205, 103, 0.4);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    0 18rpx 30rpx rgba(0, 0, 0, 0.18),
    0 0 0 1rpx rgba(243, 205, 103, 0.1);
}

.theme-card__check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 52rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(244, 211, 118, 0.94) 0%, rgba(211, 161, 64, 0.96) 100%);
  box-shadow:
    0 6rpx 12rpx rgba(0, 0, 0, 0.16),
    inset 0 1rpx 0 rgba(255, 247, 218, 0.72);
  color: #52330a;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
  z-index: 2;
}

.theme-card__preview {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 126rpx;
  flex: 0 0 auto;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 250, 235, 0.12);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    inset 0 -20rpx 28rpx rgba(0, 0, 0, 0.12);
}

.theme-card__meta {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.theme-card__title {
  color: #f4ecdd;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.theme-card--jade-green .theme-card__preview {
  background:
    linear-gradient(180deg, #5f9986 0%, #3e6659 100%);
}

.theme-card--ruby-red .theme-card__preview {
  background:
    linear-gradient(180deg, #2c2725 0%, #110f10 100%);
}

.theme-card--imperial-red .theme-card__preview {
  background:
    linear-gradient(180deg, #8e2b31 0%, #5f1317 100%);
}

.toggle-card::after,
.create-note-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 244, 205, 0.22), rgba(255, 255, 255, 0));
}

.toggle-card {
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.toggle-card__signal {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.03);
}

.toggle-card__signal.is-on {
  background: #f3cd67;
  box-shadow: 0 0 0 6rpx rgba(243, 205, 103, 0.08), 0 0 16rpx rgba(243, 205, 103, 0.22);
}

.toggle-card__signal.is-off {
  background: rgba(182, 192, 218, 0.46);
}

.toggle-copy {
  flex: 1;
  min-width: 0;
}

.toggle-title {
  display: block;
  color: #f8f1dc;
  font-size: 28rpx;
  font-weight: 800;
}

.toggle-sub {
  display: block;
  margin-top: 6rpx;
  color: rgba(210, 220, 243, 0.66);
  font-size: 21rpx;
  line-height: 1.45;
}

.toggle-pill {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(163, 174, 204, 0.18), rgba(163, 174, 204, 0.08));
  border: 1rpx solid rgba(163, 174, 204, 0.16);
  flex: 0 0 auto;
}

.toggle-pill.is-on {
  background: linear-gradient(180deg, rgba(243, 205, 103, 0.26), rgba(243, 205, 103, 0.12));
  border-color: rgba(243, 205, 103, 0.32);
  box-shadow: 0 8rpx 16rpx rgba(243, 205, 103, 0.12);
}

.toggle-pill__thumb {
  position: absolute;
  left: 6rpx;
  top: 5rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #fff9eb 0%, #f5ead1 100%);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.2s ease;
}

.toggle-pill.is-on .toggle-pill__thumb {
  transform: translateX(40rpx);
}

.create-note-card {
  padding: 22rpx 24rpx;
  margin-top: 18rpx;
}

.create-note-card--experiment {
  border-color: rgba(99, 172, 255, 0.22);
  background:
    radial-gradient(circle at 92% 12%, rgba(99, 172, 255, 0.14) 0%, rgba(99, 172, 255, 0) 46%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.018) 100%);
}

.create-note-card__title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #f8f1dc;
}

.create-note-card__desc {
  display: block;
  color: rgba(210, 220, 243, 0.68);
  font-size: 21rpx;
  line-height: 1.6;
}

.create-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.create-btn,
.cancel-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.create-btn {
  background:
    radial-gradient(circle at 30% 18%, rgba(255, 248, 216, 0.36) 0%, rgba(255, 248, 216, 0) 34%),
    linear-gradient(180deg, #f3dc58 0%, #e9c349 38%, #c39625 70%, #9f7317 100%);
  border: 1rpx solid #ffe088;
  color: #1a0c00;
  box-shadow:
    0 14rpx 34rpx rgba(233, 195, 73, 0.3),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.18),
    inset 0 -10rpx 16rpx rgba(125, 79, 7, 0.18);
}

.cancel-btn {
  background: linear-gradient(180deg, rgba(255, 247, 212, 0.08), rgba(255, 255, 255, 0.02));
  border: 1rpx solid rgba(246, 220, 132, 0.12);
  color: #f7efda;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.toggle-card:active,
.create-btn:active,
.cancel-btn:active {
  opacity: 0.94;
  transform: scale(0.985);
}

.create-page.is-perf-lite {
  background: linear-gradient(180deg, #1d1328 0%, #150c20 100%);
}

.create-page.is-perf-lite .mask-bg,
.create-page.is-perf-lite .create-sheet__glow,
.create-page.is-perf-lite .room-form-card__glow {
  display: none !important;
}

.create-page.is-perf-lite .create-sheet,
.create-page.is-perf-lite .room-form-card,
.create-page.is-perf-lite .toggle-card,
.create-page.is-perf-lite .create-note-card,
.create-page.is-perf-lite .create-sheet__footer,
.create-page.is-perf-lite .create-actions,
.create-page.is-perf-lite .create-btn,
.create-page.is-perf-lite .cancel-btn,
.create-page.is-perf-lite .toggle-pill,
.create-page.is-perf-lite .toggle-pill__thumb {
  animation: none !important;
  transition: none !important;
}

.create-page.is-perf-lite .create-sheet,
.create-page.is-perf-lite .room-form-card,
.create-page.is-perf-lite .toggle-card,
.create-page.is-perf-lite .create-note-card,
.create-page.is-perf-lite .create-sheet__footer,
.create-page.is-perf-lite .create-btn,
.create-page.is-perf-lite .cancel-btn,
.create-page.is-perf-lite .toggle-pill {
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.18) !important;
  filter: none !important;
}
