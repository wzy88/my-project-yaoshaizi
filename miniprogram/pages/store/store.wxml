<view class="page store-page">
  <view class="bg-layer bg-main"></view>
  <view class="bg-layer bg-grain"></view>

  <view class="status-row">
    <text class="status-time">{{timeText}}</text>
    <view class="status-right">
      <view class="status-mark">🎲</view>
      <text class="status-sub">皮肤 · 道具</text>
    </view>
  </view>

  <view class="wallet-card">
    <view class="wallet-left">
      <text class="coin-icon">🪙</text>
      <view>
        <text class="wallet-value">{{balanceCoins}}</text>
        <text class="wallet-label">金币</text>
      </view>
    </view>
    <button class="wallet-btn" bindtap="onTapRecharge">充值</button>
  </view>

  <view class="category-row">
    <block wx:for="{{categories}}" wx:key="key">
      <view
        class="category-item {{activeCategory === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSwitchCategory"
      >{{item.text}}</view>
    </block>
  </view>

  <view class="hero-card">
    <view class="hero-badge">当前使用</view>
    <view class="hero-cup"></view>
    <view class="hero-dots">
      <view class="dot active"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <view class="grid-list">
    <block wx:for="{{displayItems}}" wx:key="id">
      <view class="item-card">
        <view class="item-top rarity-{{item.rarity}}">
          <text class="rarity-tag">{{item.rarityLabel}}</text>
          <view class="item-preview {{item.previewTone}}">
            <text>{{item.preview}}</text>
          </view>
        </view>
        <view class="item-body">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">🪙 {{item.priceText}}</text>
          <button
            class="item-btn {{item.owned ? 'owned' : ''}}"
            data-id="{{item.id}}"
            bindtap="onTapBuyCoin"
            disabled="{{item.owned}}"
          >{{item.owned ? '已拥有' : '试用'}}</button>
        </view>
      </view>
    </block>
  </view>
</view>
