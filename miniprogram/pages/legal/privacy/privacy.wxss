.legal-page {
  height: 100vh;
  background:
    radial-gradient(circle at 50% -14%, rgba(240, 190, 80, 0.28), rgba(240, 190, 80, 0) 68%),
    radial-gradient(circle at 10% 88%, rgba(220, 160, 50, 0.14), rgba(220, 160, 50, 0) 60%),
    linear-gradient(160deg, #fdf8ec 0%, #f8edd0 45%, #f3e4ba 100%);
}

.legal-wrap {
  margin: 0 0 0;
  padding: 24rpx 18rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100%;
  background: rgba(255, 250, 230, 0.78);
  border: 1rpx solid rgba(200, 155, 40, 0.18);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(140, 90, 10, 0.08);
}

.legal-h1 {
  display: block;
  font-size: 36rpx;
  color: #2c1a06;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.legal-meta {
  display: block;
  margin-top: 8rpx;
  color: #8b5a13;
  font-size: 19rpx;
}

.legal-h2 {
  display: block;
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #c8860a;
  font-weight: 800;
  line-height: 1.35;
}

.legal-p {
  display: block;
  margin-top: 8rpx;
  color: #5a3c0a;
  font-size: 21rpx;
  line-height: 1.75;
}
