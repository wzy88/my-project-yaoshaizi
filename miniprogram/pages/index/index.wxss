.entry-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(26rpx + env(safe-area-inset-top)) 28rpx calc(56rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 16%, rgba(246, 214, 105, 0.14), rgba(246, 214, 105, 0) 28%),
    radial-gradient(circle at 50% 72%, rgba(33, 201, 153, 0.2), rgba(33, 201, 153, 0) 34%),
    linear-gradient(180deg, #140918 0%, #0d101d 100%);
}

.entry-page__aurora,
.entry-page__stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.entry-page__aurora--top {
  background: radial-gradient(circle at 50% 0%, rgba(173, 106, 255, 0.26) 0%, rgba(173, 106, 255, 0) 42%);
}

.entry-page__aurora--bottom {
  background: radial-gradient(circle at 86% 90%, rgba(28, 180, 143, 0.2) 0%, rgba(28, 180, 143, 0) 34%);
}

.entry-page__star {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.42);
}

.entry-page__star--1 { top: 138rpx; left: 88rpx; width: 6rpx; height: 6rpx; }
.entry-page__star--2 { top: 224rpx; right: 96rpx; width: 4rpx; height: 4rpx; }
.entry-page__star--3 { top: 846rpx; left: 68rpx; width: 5rpx; height: 5rpx; }
.entry-page__star--4 { top: 1084rpx; right: 78rpx; width: 4rpx; height: 4rpx; }

.status-row,
.hero-card,
.action-panel {
  position: relative;
  z-index: 1;
}

.status-row {
  display: flex;
  align-items: center;
}

.status-time {
  color: rgba(245, 247, 250, 0.92);
  font-size: 30rpx;
  font-weight: 700;
}

.hero-card {
  margin-top: 164rpx;
  padding: 46rpx 34rpx 42rpx;
  border-radius: 42rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04)),
    rgba(16, 19, 31, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 26rpx 54rpx rgba(0, 0, 0, 0.34);
  backdrop-filter: blur(18rpx);
}

.logo-row {
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.dice {
  width: 80rpx;
  height: 80rpx;
  filter: drop-shadow(0 10rpx 20rpx rgba(0, 0, 0, 0.28));
}

.dice--left {
  transform: rotate(-12deg);
}

.dice--center {
  transform: translateY(-10rpx) rotate(7deg);
}

.dice--right {
  transform: rotate(11deg);
}

.title {
  display: block;
  margin-top: 30rpx;
  text-align: center;
  color: #ffffff;
  font-size: 80rpx;
  line-height: 1.06;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.sub {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  color: #90e1c2;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.hero-tag {
  display: block;
  width: fit-content;
  max-width: 100%;
  margin: 20rpx auto 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #f7e5a7;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 215, 96, 0.12);
  border: 1rpx solid rgba(255, 215, 96, 0.18);
}

.desc {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: rgba(231, 237, 241, 0.76);
  font-size: 26rpx;
  line-height: 1.7;
}

.benefit-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
}

.benefit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f5d66b 0%, #d8a93a 100%);
  box-shadow: 0 0 16rpx rgba(245, 214, 107, 0.48);
}

.benefit-text {
  flex: 1;
  min-width: 0;
  color: rgba(244, 247, 250, 0.9);
  font-size: 24rpx;
  line-height: 1.5;
}

.action-panel {
  margin-top: 34rpx;
  padding: 24rpx 24rpx 28rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(244, 203, 95, 0.08) 0%, rgba(244, 203, 95, 0) 34%),
    rgba(14, 18, 27, 0.46);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.28);
}

.wx-btn {
  width: 100%;
  height: 108rpx;
  line-height: 108rpx;
  padding: 0;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #f7db76 0%, #e8c14c 48%, #b98f22 100%);
  color: #3c260b;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.34);
}

.wx-btn::after {
  border: 0;
}

.wx-btn__label {
  color: #3c260b;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.login-hint {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  color: rgba(240, 229, 185, 0.84);
  font-size: 22rpx;
  line-height: 1.6;
}

.connection-panel {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.connection-panel__text {
  display: block;
  text-align: center;
  color: rgba(255, 236, 176, 0.92);
  font-size: 20rpx;
  line-height: 1.6;
}

.connection-panel__btn {
  margin-top: 14rpx;
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f8f1d7;
  font-size: 26rpx;
  font-weight: 700;
}

.connection-panel__btn::after {
  border: 0;
}

.agreement {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  color: rgba(228, 233, 239, 0.58);
  font-size: 20rpx;
  line-height: 1.7;
}

.link {
  color: #f0c840;
}

.entry-page.is-perf-lite .entry-page__aurora,
.entry-page.is-perf-lite .entry-page__stars {
  display: none;
}

.entry-page.is-perf-lite .hero-card,
.entry-page.is-perf-lite .action-panel,
.entry-page.is-perf-lite .dice {
  animation: none !important;
  transition: none !important;
}

.entry-page.is-perf-lite .hero-card,
.entry-page.is-perf-lite .action-panel {
  backdrop-filter: none;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.2);
}

.entry-page.is-perf-lite .dice {
  filter: none;
}
