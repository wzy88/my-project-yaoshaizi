.entry-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(24rpx + env(safe-area-inset-top)) 28rpx calc(42rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #050616;
}

.entry-bg {
  position: absolute;
  pointer-events: none;
}

.entry-bg--ink {
  inset: 0;
  background:
    radial-gradient(circle at 48% 4%, rgba(58, 43, 136, 0.7), rgba(12, 7, 38, 0.12) 34%, rgba(4, 5, 17, 0) 58%),
    radial-gradient(circle at 18% 58%, rgba(58, 205, 255, 0.18), rgba(58, 205, 255, 0) 24%),
    radial-gradient(circle at 92% 48%, rgba(255, 57, 215, 0.2), rgba(255, 57, 215, 0) 27%),
    linear-gradient(180deg, #08051d 0%, #050616 52%, #06091a 100%);
}

.entry-bg--beam {
  height: 6rpx;
  border-radius: 999rpx;
  opacity: 0.86;
  transform-origin: center;
}

.entry-bg--beam-a {
  top: 278rpx;
  left: -54rpx;
  width: 238rpx;
  background: linear-gradient(90deg, rgba(76, 222, 255, 0), rgba(76, 222, 255, 0.95));
  box-shadow: 0 0 34rpx rgba(76, 222, 255, 0.72);
  transform: rotate(-42deg);
}

.entry-bg--beam-b {
  top: 350rpx;
  right: -32rpx;
  width: 260rpx;
  background: linear-gradient(90deg, rgba(255, 64, 224, 0.95), rgba(255, 64, 224, 0));
  box-shadow: 0 0 34rpx rgba(255, 64, 224, 0.7);
  transform: rotate(-38deg);
}

.entry-bg--glow {
  border-radius: 999rpx;
  filter: blur(6rpx);
}

.entry-bg--glow-a {
  top: 170rpx;
  left: -80rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(34, 176, 255, 0.18);
}

.entry-bg--glow-b {
  right: -90rpx;
  bottom: 250rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(164, 63, 255, 0.22);
}

.status-row,
.home-shell {
  position: relative;
  z-index: 1;
}

.status-row {
  display: flex;
  align-items: center;
  height: 42rpx;
}

.status-time {
  color: rgba(247, 249, 255, 0.94);
  font-size: 30rpx;
  font-weight: 700;
}

.home-shell {
  min-height: calc(100vh - 92rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
  padding-top: 20rpx;
}

.brand-hero {
  position: relative;
  width: 100%;
  height: 610rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-hero::after {
  content: "";
  position: absolute;
  left: 8%;
  right: 8%;
  bottom: 26rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(18, 15, 42, 0.88);
  box-shadow: 0 0 70rpx rgba(111, 72, 255, 0.42);
}

.brand-hero__logo {
  position: relative;
  z-index: 1;
  width: 726rpx;
  height: 660rpx;
  margin-top: -20rpx;
  filter: drop-shadow(0 22rpx 42rpx rgba(3, 4, 20, 0.72));
}

.create-card {
  position: relative;
  min-height: 306rpx;
  padding: 48rpx 34rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 72% 44%, rgba(75, 120, 255, 0.54), rgba(75, 120, 255, 0) 38%),
    radial-gradient(circle at 18% 20%, rgba(218, 87, 255, 0.34), rgba(218, 87, 255, 0) 46%),
    linear-gradient(135deg, rgba(87, 44, 128, 0.88) 0%, rgba(23, 20, 91, 0.92) 58%, rgba(9, 23, 71, 0.92) 100%);
  border: 2rpx solid rgba(188, 105, 255, 0.74);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.1),
    inset 0 0 70rpx rgba(93, 107, 255, 0.24),
    0 22rpx 50rpx rgba(2, 3, 17, 0.56),
    0 0 38rpx rgba(131, 74, 255, 0.46);
}

.create-card__shine {
  position: absolute;
  border-radius: 999rpx;
  opacity: 0.82;
}

.create-card__shine--left {
  left: -88rpx;
  top: -40rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 106, 229, 0.36), rgba(255, 106, 229, 0));
}

.create-card__shine--right {
  right: 22rpx;
  bottom: -110rpx;
  width: 330rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(55, 211, 255, 0.38), rgba(55, 211, 255, 0));
}

.create-card__copy {
  position: relative;
  z-index: 2;
  width: 360rpx;
}

.create-card__title {
  display: block;
  color: #ffffff;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 900;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.42);
}

.create-card__sub {
  display: block;
  margin-top: 18rpx;
  color: rgba(231, 225, 255, 0.58);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}

.create-card__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 290rpx;
  height: 84rpx;
  margin: 38rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #cf4fff 0%, #8d31d7 48%, #5b25a9 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.32),
    0 14rpx 28rpx rgba(35, 2, 80, 0.48),
    0 0 22rpx rgba(225, 83, 255, 0.48);
}

.create-card__btn::after,
.quick-btn::after {
  border: 0;
}

.create-card__btn-icon {
  width: 38rpx;
  height: 38rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.24));
}

.create-card__btn-text {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.32);
}

.dice-cup {
  position: absolute;
  right: -12rpx;
  top: -44rpx;
  width: 348rpx;
  height: 334rpx;
  z-index: 1;
}

.dice-cup__body {
  position: absolute;
  right: 44rpx;
  top: 2rpx;
  width: 186rpx;
  height: 220rpx;
  border-radius: 62rpx 62rpx 52rpx 52rpx;
  background:
    radial-gradient(circle at 35% 26%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 24%),
    linear-gradient(150deg, #3a2d76 0%, #211943 45%, #150f2d 100%);
  box-shadow:
    inset -18rpx -14rpx 26rpx rgba(0, 0, 0, 0.3),
    inset 16rpx 12rpx 24rpx rgba(135, 95, 255, 0.24),
    0 16rpx 36rpx rgba(0, 0, 0, 0.48);
  transform: rotate(18deg);
}

.dice-cup__ring {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #64d7ff;
  box-shadow: 0 0 22rpx rgba(100, 215, 255, 0.86);
}

.dice-cup__ring--top {
  top: 36rpx;
}

.dice-cup__ring--bottom {
  left: -18rpx;
  right: -18rpx;
  bottom: 20rpx;
  height: 20rpx;
}

.dice-cup__mark {
  position: absolute;
  left: 52rpx;
  top: 86rpx;
  width: 74rpx;
  height: 58rpx;
  border: 6rpx solid rgba(170, 98, 255, 0.26);
  border-radius: 18rpx;
  transform: rotate(20deg);
}

.dice-cup__light {
  position: absolute;
  right: 24rpx;
  bottom: 44rpx;
  width: 260rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(70, 207, 255, 0.68), rgba(130, 66, 255, 0.22) 48%, rgba(130, 66, 255, 0));
  filter: blur(8rpx);
}

.card-die {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  z-index: 3;
  filter: drop-shadow(0 12rpx 18rpx rgba(0, 0, 0, 0.42));
}

.card-die--one {
  right: 160rpx;
  bottom: 42rpx;
  transform: rotate(-13deg);
}

.card-die--two {
  right: 78rpx;
  bottom: 76rpx;
  transform: rotate(12deg);
}

.card-die--three {
  right: 10rpx;
  bottom: 48rpx;
  transform: rotate(18deg);
}

.quick-row {
  display: flex;
  gap: 18rpx;
}

.quick-btn {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0;
  border-radius: 999rpx;
}

.quick-btn--primary {
  background: linear-gradient(180deg, #33d8ff 0%, #147dff 100%);
  box-shadow: 0 14rpx 30rpx rgba(19, 124, 255, 0.32);
}

.quick-btn--ghost {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(126, 212, 255, 0.28);
  box-shadow: inset 0 0 28rpx rgba(88, 72, 255, 0.2);
}

.quick-btn__text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.hint-panel {
  padding: 2rpx 12rpx 0;
}

.login-hint {
  display: block;
  text-align: center;
  color: rgba(225, 225, 248, 0.62);
  font-size: 22rpx;
  line-height: 1.6;
}

.connection-panel {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.connection-panel__text {
  display: block;
  text-align: center;
  color: rgba(255, 222, 245, 0.92);
  font-size: 20rpx;
  line-height: 1.6;
}

.agreement {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: rgba(213, 216, 236, 0.5);
  font-size: 20rpx;
  line-height: 1.7;
}

.link {
  color: #ff63dd;
}

.entry-page.is-perf-lite .entry-bg--beam,
.entry-page.is-perf-lite .entry-bg--glow,
.entry-page.is-perf-lite .brand-hero__logo,
.entry-page.is-perf-lite .create-card,
.entry-page.is-perf-lite .card-die,
.entry-page.is-perf-lite .dice-cup__light {
  filter: none;
}

.entry-page.is-perf-lite .brand-hero::after,
.entry-page.is-perf-lite .create-card,
.entry-page.is-perf-lite .create-card__btn,
.entry-page.is-perf-lite .quick-btn {
  box-shadow: none;
}
