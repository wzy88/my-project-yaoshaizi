<view class="login-page">
  <view class="login-page__nebula login-page__nebula--top"></view>
  <view class="login-page__nebula login-page__nebula--bottom"></view>
  <view class="login-page__stars">
    <view class="login-page__star login-page__star--1"></view>
    <view class="login-page__star login-page__star--2"></view>
    <view class="login-page__star login-page__star--3"></view>
    <view class="login-page__star login-page__star--4"></view>
    <view class="login-page__star login-page__star--5"></view>
    <view class="login-page__star login-page__star--6"></view>
  </view>

  <view class="status-row">
    <text class="status-time">{{timeText}}</text>
  </view>

  <view class="hero-card">
    <view class="logo-row">
      <image class="dice dice--left" src="{{heroDiceAssets[0]}}" mode="aspectFit"></image>
      <image class="dice dice--center" src="{{heroDiceAssets[1]}}" mode="aspectFit"></image>
      <image class="dice dice--right" src="{{heroDiceAssets[2]}}" mode="aspectFit"></image>
    </view>

    <text class="title">摇骰子</text>
    <text class="sub">LIAR'S DICE · 在线对局</text>
    <text class="desc">进入大厅，创建房间或加入正在进行的酒桌局。</text>
  </view>

  <view class="action-panel">
    <button class="wx-btn" bindtap="onWechatLogin">
      <text class="wx-btn__label">微信快速进入</text>
    </button>
    <text class="agreement">登录即同意 <text class="link" bindtap="openTermsPage">用户协议</text> 与 <text class="link" bindtap="openPrivacyPage">隐私政策</text></text>
  </view>
</view>
