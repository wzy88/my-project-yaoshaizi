.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.tab-inner {
  position: relative;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding: 6rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(28, 19, 38, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 -10rpx 26rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}

.tab-item,
.tab-center-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
}

.tab-item {
  padding-top: 8rpx;
  align-items: center;
  flex-direction: column;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  position: relative;
}

.tab-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a8494;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-label {
  color: #23b56f;
}

.tab-center-wrap {
  align-items: flex-start;
}

.tab-center {
  margin-top: -10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-center-ball {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  background: linear-gradient(145deg, #14804c 6.17%, #23b56f 35.39%, #34d388 64.61%, #14804c 93.83%);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  box-shadow:
    0 0 32rpx rgba(35, 181, 111, 0.3),
    0 8rpx 24rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-center.active .tab-center-ball {
  box-shadow:
    0 0 28rpx rgba(35, 181, 111, 0.42),
    0 10rpx 22rpx rgba(0, 0, 0, 0.44);
}

.tab-center-ball__die {
  width: 38rpx;
  height: 38rpx;
}

.icon-home__roof {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 26rpx;
  height: 26rpx;
  border-top: 4rpx solid #7a8494;
  border-left: 4rpx solid #7a8494;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.icon-home__body {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 24rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.icon-me__head {
  position: absolute;
  top: 7rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-me__body {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 30rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  box-sizing: border-box;
}

.tab-item.active .icon-home__roof,
.tab-item.active .icon-home__body,
.tab-item.active .icon-me__head,
.tab-item.active .icon-me__body {
  border-color: #23b56f;
}

.tab-item:active,
.tab-center:active {
  opacity: 0.92;
}
