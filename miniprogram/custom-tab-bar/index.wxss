.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  height: 142rpx;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  pointer-events: none;
}

.tab-inner {
  position: relative;
  width: 636rpx;
  height: 96rpx;
  padding: 8rpx 36rpx 10rpx;
  background: rgba(13, 10, 30, 0.98);
  border: 2rpx solid rgba(136, 81, 208, 0.2);
  border-radius: 34rpx;
  box-shadow:
    0 0 14rpx rgba(158, 75, 255, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: visible;
  pointer-events: auto;
}

.tab-inner::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -38rpx;
  width: 148rpx;
  height: 82rpx;
  transform: translateX(-50%);
  border-radius: 82rpx 82rpx 28rpx 28rpx;
  background: rgba(13, 10, 30, 0.98);
  border: 0;
  box-shadow: none;
  z-index: 0;
}

.tab-inner::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -2rpx;
  width: 138rpx;
  height: 32rpx;
  transform: translateX(-50%);
  border-radius: 0 0 70rpx 70rpx;
  background: rgba(13, 10, 30, 0.98);
  z-index: 1;
}

.tab-notch {
  position: absolute;
  left: 50%;
  top: -31rpx;
  width: 120rpx;
  height: 58rpx;
  transform: translateX(-50%);
  border-radius: 64rpx 64rpx 24rpx 24rpx;
  background: rgba(13, 10, 30, 0.98);
  box-shadow: none;
  z-index: 1;
}

.tab-item,
.tab-center-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
}

.tab-item {
  position: relative;
  z-index: 3;
  height: 78rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border-radius: 28rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.tab-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(142, 139, 158, 0.86);
  font-weight: 800;
  letter-spacing: 0;
}

.tab-item.active .tab-label {
  color: #b45bff;
  text-shadow: none;
}

.tab-center-wrap {
  position: relative;
  z-index: 4;
  align-items: center;
}

.tab-center {
  margin-top: -48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 68rpx;
}

.tab-center-ball {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #191230;
  border: 8rpx solid #a94aff;
  box-shadow:
    0 0 20rpx rgba(169, 74, 255, 0.52),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tab-center.active .tab-center-ball {
  box-shadow:
    0 0 22rpx rgba(169, 74, 255, 0.58),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.18);
}

.tab-center-dice {
  width: 60rpx;
  height: 60rpx;
}

.icon-home__roof {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 26rpx;
  height: 26rpx;
  border-top: 4rpx solid #7a8494;
  border-left: 4rpx solid #7a8494;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.icon-home__body {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 24rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.icon-me__head {
  position: absolute;
  top: 7rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-me__body {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 30rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border: 4rpx solid #7a8494;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  box-sizing: border-box;
}

.tab-item.active .icon-home__roof,
.tab-item.active .icon-home__body,
.tab-item.active .icon-me__head,
.tab-item.active .icon-me__body {
  border-color: #b45bff;
}

.tab-item:active,
.tab-center:active {
  opacity: 0.92;
}

/* Premium black-gold tab theme. */
.tab-inner,
.tab-inner::before,
.tab-inner::after,
.tab-notch {
  background: rgba(5, 9, 10, 0.96);
}

.tab-inner {
  border: 1rpx solid rgba(218, 183, 111, 0.2);
  box-shadow:
    0 18rpx 34rpx rgba(0, 0, 0, 0.34),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    0 0 0 1rpx rgba(4, 8, 8, 0.65);
}

.tab-inner::before {
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.tab-item.active {
  background: rgba(218, 183, 111, 0.08);
}

.tab-label {
  color: rgba(234, 229, 216, 0.48);
}

.tab-item.active .tab-label {
  color: #e2c17b;
  text-shadow: 0 0 14rpx rgba(214, 181, 111, 0.18);
}

.tab-center-ball {
  background:
    radial-gradient(circle at 34% 22%, rgba(255, 247, 218, 0.22), rgba(255, 247, 218, 0) 34%),
    linear-gradient(180deg, #172b24 0%, #071011 100%);
  border-color: #d7ad5b;
  box-shadow:
    0 12rpx 24rpx rgba(0, 0, 0, 0.32),
    0 0 18rpx rgba(214, 181, 111, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.18);
}

.tab-center:active .tab-center-ball {
  transform: scale(0.97);
}

.icon-home__roof,
.icon-home__body,
.icon-me__head,
.icon-me__body {
  border-color: rgba(234, 229, 216, 0.5);
}

.tab-item.active .icon-home__roof,
.tab-item.active .icon-home__body,
.tab-item.active .icon-me__head,
.tab-item.active .icon-me__body {
  border-color: #e2c17b;
}
